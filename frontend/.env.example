# Copy to .env and edit. docker compose reads .env automatically.

# Host port for the nginx-served React app.
FRONTEND_PORT=8080

# Absolute or relative path (resolved from the compose file's directory) to
# EITHER:
#   - a single codebase-mapper output bundle directory containing
#     run_manifest.json, inventory.ttl, embeddings.npz, embeddings_meta.json,
#     concepts.json (and optionally concepts_embeddings.npz + blobs/), or
#   - a parent directory containing one or more bundle subdirectories.
# The picker in the UI lists every subdir with a run_manifest.json.
CBM_BUNDLE=../_tmp

# Image tag for both images.
TAG=latest

# Set to 1 to install sentence-transformers in the backend image. Required for
# real semantic search on /api/chunks/search when the bundle was generated with
# --backend sbert. Adds ~2 GB to the image; defaults off.
WITH_SBERT=0
