# =============================================================================
# usl-ng-plan.ttl
# An instance of software-project-plan.ttl v4.0.0 describing usl-ng-core.
# Format: Turtle 1.1 (W3C Recommendation, 2014).
# Validates: as RDF data against the SHACL shapes in
#            canonical/software-project-plan.ttl.
# =============================================================================
#
# DISCLAIMER. No information in this document should be taken for granted.
# Any statement or premise not backed by a real logical definition or
# verifiable reference may be invalid, erroneous, or a hallucination.
# Concept-IRI values are drawn from the schema's enumerated SKOS schemes;
# the categorical classification of usl-ng-core into those schemes is the
# instance author's synthesis, grounded in PURPOSE.md, README.md,
# CLAUDE.md, Cargo.toml, every crate's Cargo.toml under crates/, the
# proofs/ Lean configuration (lean-toolchain, lake-manifest.json,
# lakefile.lean), and the .github/workflows directory of this
# repository, not consensus standards.
#
# Generated by: Claude Opus 4.7 (1M context) via Claude Code
# Date: 2026-05-15
#
# Pass 5 (2026-05-15) refinement, driven by the usl-ng-core CBM bundle
# (commit 293d08d, generated 2026-05-16T00:51:52Z):
#   - Licence: replaced the speculative Apache-2.0 IRI with MIT, as
#     declared in [workspace.package] license = "MIT" and in
#     ./LICENSE (Copyright (c) 2025 Pedro Anisio Silva).
#   - Internal-spine PlannedLinks: added the seven edges that were
#     missing in pass 4 — lexer→ast, parser→ast, semantic→parser,
#     eval→ast, eval→parser, cli→eval, cli→printer. Source: per-crate
#     [dependencies] in commit 293d08d.
#   - Contract-test harness coverage caveat: documented that
#     usl-ng-emit-contract-tests/Cargo.toml lists 11 of the 12 emitter
#     adapters; typecarta is absent. Replaced the paraphrased Cargo
#     description with the verbatim text.
#   - Self-describing artefacts: noted that the repo ships its own
#     SHACL schema (canonical/software-project-plan.ttl) and plan
#     instance (canonical/usl-ng-plan.ttl), modelled as project
#     provenance rather than spp:Component nodes.
#   - Sharpened the §2.3 rule on which dependency rows are listed,
#     specifically calling out the in-tree path-deps and the direct
#     crates-io deps (notify, rustyline) that the rule excludes.
#   - Lean mechanization: recorded the v4.12.0 toolchain pin and the
#     empty lake-manifest.json packages list as the mechanical
#     realisation of adr-no-mathlib.
# =============================================================================

@prefix spp:    <https://software-project-plan.org/v4/ontology#> .
@prefix sppe:   <https://software-project-plan.org/v4/entity#> .
@prefix sppc:   <https://software-project-plan.org/v4/concept/> .
@prefix sppt:   <https://software-project-plan.org/v4/tier#> .

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .

@prefix uslng:  <https://github.com/pedroanisio/usl-ng-core/plan#> .

# =============================================================================
# 1. THE PLAN
# =============================================================================

uslng:plan
    a spp:SoftwareProjectPlan ;
    dct:title "USL-NG Core — Project Plan"@en ;
    dct:description """Plan-level categorical declarations for usl-ng-core:
        a Rust workspace + Lean 4 mechanization defining the §4 AST,
        loss-aware emitter contract, and Phase-2/3/4 proofs of the
        USL-NG specification."""@en ;
    dct:created "2026-05-15"^^xsd:date ;
    dct:modified "2026-05-15"^^xsd:date ;
    dct:conformsTo <https://software-project-plan.org/v4.1.0> ;
    # SPP v4.1.0 added Dublin Core predicates (conformsTo, identifier,
    # creator, license, issued, hasVersion) to SoftwareProjectPlanShape's
    # sh:ignoredProperties list, so the dct:* triples below are now legal
    # on the plan node and carry provenance / versioning explicitly.

    dct:identifier <https://github.com/pedroanisio/usl-ng-core> ;
    dct:hasVersion "0.1.0-alpha.22" ;
    # Mirrors spp:planVersion above. dct:hasVersion is the W3C-standard
    # carrier for the version of the described resource; spp:planVersion
    # is the project-plan-ontology equivalent. The duplication is
    # intentional: it lets generic SKOS/DCT consumers find the version
    # without knowing the SPP vocabulary, and the regression test in
    # scripts/test_validate_plan_ttl.py asserts the two strings agree
    # so they cannot drift.
    dct:license <https://spdx.org/licenses/MIT> ;
    # Verified 2026-05-15 against the bundled repository snapshot
    # (commit 293d08d, usl-ng-core CBM bundle):
    #   - Cargo.toml [workspace.package] declares `license = "MIT"`.
    #   - LICENSE at repo root is the standard MIT licence text,
    #     "Copyright (c) 2025 Pedro Anisio Silva".
    # Earlier passes of this instance recorded an *intended* Apache-2.0
    # licence under the assumption that the workspace had not yet
    # declared one; that assumption was wrong and the IRI was corrected.
    # The regression test in scripts/test_validate_plan_ttl.py should
    # assert that this IRI matches the SPDX form of the licence string
    # in [workspace.package] (currently MIT).

    spp:planName    "usl-ng-core" ;
    spp:planVersion "0.1.0-alpha.22" ;
    # Workspace version from Cargo.toml [workspace.package]; the project
    # has not yet cut a 0.1.0 release.

    # -------------------------------------------------------------------------
    # 1.1 Visibility, tenancy, concurrency, security primitives
    # -------------------------------------------------------------------------
    spp:visibility           sppc:vis-open-source ;
    # tenancyModel: deliberately omitted. usl-ng-core has no runtime
    # multi-tenancy boundary; it is a CLI + library + proof tree.
    # The schema warns (Tier-0) when omitted — that warning is acknowledged
    # and answered: tenancy is not-applicable here, not undeclared by oversight.

    spp:concurrencyModel     sppc:concurrency-threads ;
    # No network auth surface in the CLI/library; authenticationMechanism omitted.
    # idempotencyPolicy omitted — the emitters are pure functions, not RPC handlers.
    # cachingStrategy omitted — Cargo's incremental build is the only "cache",
    # which is build-tool territory, not application caching.

    spp:privacyPosture       sppc:priv-not-considered ;
    # Defensible: usl-ng-core processes user-authored .usl source files
    # locally; no PII is collected or transmitted. The "not considered"
    # value is the honest declaration per PURPOSE.md §"What This Is Not".

    spp:accessibilityPosture sppc:a11y-none ;
    # CLI-only project; no UI surface to which WCAG would apply.

    spp:sustainabilityPosture sppc:sus-not-considered ;
    spp:sbomPolicy           sppc:sbom-policy-none ;

    # -------------------------------------------------------------------------
    # 1.2 Architecture, data, API
    # -------------------------------------------------------------------------
    spp:architecturePattern  sppc:ap-hexagonal ;
    # Justified: usl-ng-emit-common defines a target-agnostic emitter
    # contract (signature, loss, family, canonical, bidir, sig_gate,
    # refinement, runtime_context); each target crate is an adapter.

    # dataStorageParadigm: omitted. The project does not persist state;
    # it reads source models and emits artifacts.

    spp:apiSpecification     sppc:api-openapi ,
                             sppc:api-graphql ;
    # Both API-spec families the project emits to. The
    # SoftwareProjectPlanShape places no sh:maxCount on this field
    # (verified in pass 4 against SPP v4.1.0), so multiple values are
    # admissible. Earlier instance versions declared only one; the
    # walk-back was based on a misreading of the schema.
    # Other emitters (Avro, JSON Schema, Prisma, Protobuf, Pydantic,
    # SHACL, SQL Postgres, TypeScript, Zod) are validation/schema/
    # codegen surfaces, not API-specification families, so they are
    # declared as components in §2 rather than duplicated here.

    spp:versioningScheme     sppc:ver-semver ;

    # deploymentStrategy / rollbackPolicy: omitted. usl-ng-core has no
    # deployment posture; releases are crate publications and git tags.

    spp:branchingStrategy    sppc:br-trunk ;
    # Inferred from repository state: single `main` branch is the integration
    # target; feature work merges directly. No long-lived release branches.

    # -------------------------------------------------------------------------
    # 1.3 Project kind & runtime
    # -------------------------------------------------------------------------
    spp:projectKind          sppc:pk-framework ;
    # USL-NG is a framework defining a §4 AST and emitter contract that
    # downstream targets bind to; the `uslng` CLI is one consumer of the
    # framework, not the project's primary identity.

    spp:runtimePlatform      sppc:rt-rust ;

    # cloudTopology: omitted. The project does not deploy to any cloud.

    # -------------------------------------------------------------------------
    # 1.4 Build, CI/CD, tooling
    # -------------------------------------------------------------------------
    spp:ciCdProvider         sppc:cicd-github-actions ;
    spp:buildTool            sppc:bt-cargo ;
    # containerTool / infrastructureTool / platformEngineeringPattern: omitted.
    # No containers, no IaC, no platform-engineering surface in scope.

    # -------------------------------------------------------------------------
    # 1.5 Observability
    # -------------------------------------------------------------------------
    # monitoringPlatform / observabilityPractice: omitted.
    # The CLI emits diagnostics to stderr; nothing is monitored at runtime
    # because there is no runtime to monitor.

    # -------------------------------------------------------------------------
    # 1.6 Testing
    # -------------------------------------------------------------------------
    spp:testMethodology      sppc:tm-tdd ;
    # CLAUDE.md §"Core Principles" mandates Red → Green → Refactor → Cleanup.
    spp:testCategory         sppc:tc-unit ,
                             sppc:tc-integration ,
                             sppc:tc-contract ,
                             sppc:tc-regression ,
                             sppc:tc-e2e ;
    # - tc-contract:  usl-ng-emit-contract-tests is the cross-emitter
    #                 regression harness. Its Cargo.toml description
    #                 (verbatim): "Cross-emitter regression harness.
    #                 Verifies that every `usl-ng-emit-*` crate
    #                 satisfies the [`Emitter`] trait-level contract
    #                 declared in emitter-roadmap §2 — closes P1 #10
    #                 from drift-risk-map.md." Caveat: as of commit
    #                 293d08d, the harness's [dependencies] list 11 of
    #                 the 12 emitter adapters; usl-ng-emit-typecarta is
    #                 absent. The "every adapter" claim is therefore
    #                 the harness's *aspirational scope*, not its
    #                 currently-wired coverage. Tracked at
    #                 link-contract-tests-uses-emit-common (§5).
    # - tc-e2e:       .github/workflows/samples.yml builds the uslng
    #                 CLI in --release and runs `uslng check` on every
    #                 docs/usl-ng-samples/*.usl-ng plus every
    #                 docs/usl-ng-samples/tutorial/*.usl-ng on each
    #                 push to main and every PR. A second job
    #                 (check-emitted) regenerates examples/emitted/ via
    #                 scripts/regenerate_sample_emits.sh and fails on
    #                 uncommitted diffs — converting silent emitter
    #                 drift into a build-error propagation mode.
    spp:testTechnique        sppc:tt-property-based ;
    # proptest = "1.9" is declared as a dev-dependency in
    # usl-ng-parser/Cargo.toml, usl-ng-printer/Cargo.toml, and
    # usl-ng-semantic/Cargo.toml. No snapshot testing framework (insta,
    # expect_test, snapbox) is present in the workspace, so tt-snapshot
    # was removed in pass 3.
    #
    # Companion drift-risk regression tests, not covered by a single
    # SPP testCategory but each independently asserted at every CI run:
    #   - crates/usl-ng-ast/tests/spec_schema_sync.rs uses `syn` to
    #     parse the AST crate's own `pub struct` definitions and check
    #     that every public field is mentioned in docs/open/usl-ng-spec.md
    #     §4. This is the mechanical realisation of the "spec = AST"
    #     contract.
    #   - .github/workflows/samples.yml `check-emitted` regenerates
    #     examples/emitted/ and fails on any uncommitted diff (P1 #34
    #     from drift-risk-map.md).
    #   - .github/workflows/ci.yml `docspace` job runs
    #     scripts/test_doc_docspace_check.py followed by
    #     scripts/doc_docspace_check.py against the live tree on every
    #     push and PR.
    #   - scripts/test_validate_plan_ttl.py exercises the regression
    #     that asserts plan-time consistency between dct:hasVersion and
    #     spp:planVersion (see §1 above).

    # -------------------------------------------------------------------------
    # 1.7 Security
    # -------------------------------------------------------------------------
    # securityTestingPractice: omitted. The project's threat model is
    # "trust the user authoring local .usl files"; SAST/DAST do not apply
    # to a pure-function emitter library at the project's current scope.
    # securityModel: omitted for the same reason. The Tier-1 warning is
    # acknowledged: there is no authorization perimeter in usl-ng-core.

    spp:supplyChainSecurityPractice sppc:scs-dep-pinning ;
    # Cargo.lock is committed at the workspace root.

    # privacyCompliancePractice: omitted. No regulated data in scope.

    # -------------------------------------------------------------------------
    # 1.8 Process, engineering practices, compliance
    # -------------------------------------------------------------------------
    # processMethodology: omitted. Solo + AI-agent contribution model;
    # neither Scrum nor Kanban nor Shape Up is in use as a named methodology.

    spp:engineeringPractice  sppc:ep-tdd ,
                             sppc:ep-ci ,
                             sppc:ep-code-review ,
                             sppc:ep-trunk-based ,
                             sppc:ep-refactoring ,
                             sppc:ep-clean-arch ;
    # ep-clean-arch added in pass 3: usl-ng-emit-common is an explicit
    # port (mr-port in §2), every usl-ng-emit-* crate is an adapter
    # (mr-adapter), and the contract is asserted by a separate harness
    # (usl-ng-emit-contract-tests). This is the textbook hexagonal /
    # clean-architecture layout, not an aspirational claim.

    spp:complianceLevel      sppc:cl-na ;

    spp:documentationApproach sppc:da-docs-as-code ;
    # docs/open/usl-ng-spec.md, docs/open/seed-formalization-v0_5_0.md,
    # docs/proposals/UEP-*, proofs/README.md, per-crate READMEs, and
    # the Lean mechanization in proofs/USLNG/ all live in the source
    # tree and version with the code. A rustdoc site is published by
    # .github/workflows/docs.yml (RUSTDOCFLAGS=-D warnings, GitHub
    # Pages deploy, build job → deploy job with id-token: write), but
    # that is a build artefact of the docs-as-code approach, not a
    # separate da-docs-site methodology. Note: docs/ is excluded from
    # the usl-ng-core CBM bundle by .cbmignore (it lists `docs`,
    # `examples/`, `fixtures/`, `target/`, `.repo/`) so the bundle's
    # file listing does not surface these paths; this is a snapshot
    # artefact, not absence of the documents. Schema enforces maxCount
    # 1 on this field, so only the primary approach is named.

    spp:aiMlPosture          sppc:ai-none ;
    # The project does not embed, train, fine-tune, or host any AI model.
    # AI agents (Claude Code) are used to *author* the project (per
    # CLAUDE.md), but no AI is part of the shipped artifact.

    spp:finOpsPosture        sppc:fo-not-tracked ;

    # dataStreamingPattern / messagingPlatform: omitted. No streaming
    # data, no message broker, no event bus.

    # -------------------------------------------------------------------------
    # 1.9 Quality characteristics and operational excellence
    # -------------------------------------------------------------------------
    spp:qualityCharacteristic sppc:qc-functional-suitability ,
                              sppc:qc-maintainability ,
                              sppc:qc-reliability ;
    # operationalExcellenceArea: omitted. The AWS WAF lens does not
    # naturally apply to a non-running codebase.

    spp:maintenanceType      sppc:maint-perfective ,
                             sppc:maint-corrective ;

    # -------------------------------------------------------------------------
    # 1.10 SEMAT Essence alpha states (current snapshot, 2026-05-15)
    # -------------------------------------------------------------------------
    spp:stakeholderAlphaState      sppc:stk-involved ;
    spp:opportunityAlphaState      sppc:opp-viable ;
    # Upgraded in pass 3 from `opp-solution-needed` → `opp-viable`. The
    # SEMAT progression is Identified → Solution Needed → Value
    # Established → Viable → Addressed → Benefit Accrued. Twelve emitter
    # targets and a contract-test harness running on every push
    # demonstrate that a *viable* solution exists; `solution-needed`
    # understated the state.
    spp:requirementsAlphaState     sppc:req-addressed ;
    # Upgraded in pass 3 from `req-coherent` → `req-addressed`. SEMAT
    # progression: Conceived → Bounded → Coherent → Acceptable →
    # Addressed → Fulfilled. The §4 AST, λ_Shape signatures, and loss
    # decomposition produce running emitters (Addressed); `Fulfilled`
    # would overclaim because §9.11 conjectures remain open and the
    # projection frontier is open-ended (PURPOSE.md §"One core, many
    # projections").
    spp:softwareSystemAlphaState   sppc:sys-demonstrable ;
    # All emitter targets run end-to-end (samples.yml CI proves this);
    # the system is demonstrable but not yet `sys-usable` in the SEMAT
    # sense (no v1.0 release, alpha.22 from Cargo.toml).
    spp:teamAlphaState             sppc:team-formed ;
    spp:wayOfWorkingAlphaState     sppc:wow-in-use ;
    spp:workAlphaState             sppc:work-under-control ;

    # -------------------------------------------------------------------------
    # 1.11 Components, decisions, environments, links
    # -------------------------------------------------------------------------
    spp:component
        # Core pipeline
        uslng:c-ast ,
        uslng:c-lexer ,
        uslng:c-parser ,
        uslng:c-semantic ,
        uslng:c-printer ,
        uslng:c-cli ,
        # Emitter contract (the port) + cross-target conformance harness
        uslng:c-emit-common ,
        uslng:c-emit-contract-tests ,
        # Emitter adapters — current checkpoints against the projection
        # frontier; not its ceiling (PURPOSE.md §"One core, many projections")
        uslng:c-emit-avro ,
        uslng:c-emit-graphql ,
        uslng:c-emit-json-schema ,
        uslng:c-emit-openapi ,
        uslng:c-emit-prisma ,
        uslng:c-emit-protobuf ,
        uslng:c-emit-pydantic ,
        uslng:c-emit-shacl ,
        uslng:c-emit-sql-postgres ,
        uslng:c-emit-typecarta ,
        uslng:c-emit-typescript ,
        uslng:c-emit-zod ,
        # Evaluation harness + Lean mechanization
        uslng:c-eval ,
        uslng:c-proofs ;

    spp:decision
        uslng:adr-ast-source-of-truth ,
        uslng:adr-emitter-port-decomposition ,
        uslng:adr-declared-loss-not-implied ,
        uslng:adr-pure-addition ,
        uslng:adr-wildcard-deny-lint ,
        uslng:adr-no-mathlib ;

    spp:plannedEnvironment
        uslng:env-local ,
        uslng:env-dev ;

    spp:plannedLink
        # Internal core dependencies
        uslng:link-lexer-depends-on-ast ,
        uslng:link-parser-depends-on-lexer ,
        uslng:link-parser-depends-on-ast ,
        uslng:link-semantic-depends-on-ast ,
        uslng:link-semantic-depends-on-parser ,
        uslng:link-printer-depends-on-ast ,
        uslng:link-eval-depends-on-ast ,
        uslng:link-eval-depends-on-parser ,
        uslng:link-cli-uses-semantic ,
        uslng:link-cli-uses-eval ,
        uslng:link-cli-uses-printer ,
        # Every emitter adapter implements the contract in emit-common.
        # This is the central architectural claim of the project (one
        # contract, many projections), so each adapter→port link is
        # declared individually rather than aggregated.
        uslng:link-emit-avro-implements-common ,
        uslng:link-emit-graphql-implements-common ,
        uslng:link-emit-json-schema-implements-common ,
        uslng:link-emit-openapi-implements-common ,
        uslng:link-emit-prisma-implements-common ,
        uslng:link-emit-protobuf-implements-common ,
        uslng:link-emit-pydantic-implements-common ,
        uslng:link-emit-shacl-implements-common ,
        uslng:link-emit-sql-postgres-implements-common ,
        uslng:link-emit-typecarta-implements-common ,
        uslng:link-emit-typescript-implements-common ,
        uslng:link-emit-zod-implements-common ,
        # Contract-test harness exercises the contract
        uslng:link-contract-tests-uses-emit-common .

# =============================================================================
# 2. COMPONENTS
# =============================================================================

uslng:c-ast
    a spp:Component ;
    rdfs:label "usl-ng-ast"@en ;
    spp:componentName "usl-ng-ast" ;
    spp:moduleRole sppc:mr-domain ;
    spp:declaredDependency uslng:dep-serde ,
                           uslng:dep-serde-json ,
                           uslng:dep-miette .
    # Per-crate declaredDependency lists name only workspace dependencies
    # (those in [workspace.dependencies] of Cargo.toml). Per-crate
    # dev-dependencies (e.g. syn for the §4-schema-sync test, proptest)
    # and Cargo-internal feature flags are out of scope, matching the
    # rule documented at §2.3 of this file.

uslng:c-lexer
    a spp:Component ;
    rdfs:label "usl-ng-lexer"@en ;
    spp:componentName "usl-ng-lexer" ;
    spp:moduleRole sppc:mr-infrastructure ;
    spp:declaredDependency uslng:dep-logos ,
                           uslng:dep-thiserror ,
                           uslng:dep-miette .

uslng:c-parser
    a spp:Component ;
    rdfs:label "usl-ng-parser"@en ;
    spp:componentName "usl-ng-parser" ;
    spp:moduleRole sppc:mr-infrastructure ;
    spp:declaredDependency uslng:dep-thiserror ,
                           uslng:dep-serde-json ,
                           uslng:dep-miette .

uslng:c-semantic
    a spp:Component ;
    rdfs:label "usl-ng-semantic"@en ;
    spp:componentName "usl-ng-semantic" ;
    spp:moduleRole sppc:mr-application ;
    spp:declaredDependency uslng:dep-thiserror ,
                           uslng:dep-miette .

uslng:c-printer
    a spp:Component ;
    rdfs:label "usl-ng-printer"@en ;
    spp:componentName "usl-ng-printer" ;
    spp:moduleRole sppc:mr-presentation ;
    spp:declaredDependency uslng:dep-thiserror ,
                           uslng:dep-serde-json ,
                           uslng:dep-miette .

uslng:c-cli
    a spp:Component ;
    rdfs:label "usl-ng-cli (uslng binary)"@en ;
    spp:componentName "usl-ng-cli" ;
    spp:moduleRole sppc:mr-presentation ;
    spp:declaredDependency uslng:dep-clap ,
                           uslng:dep-miette ,
                           uslng:dep-serde-json .
    # In addition to the three workspace dependencies above, the CLI's
    # crates/usl-ng-cli/Cargo.toml declares two crates-io dependencies
    # *directly* (not via [workspace.dependencies]): `notify = "6.1"`
    # for filesystem watching and `rustyline = "14"` for the REPL
    # subcommand. They are intentionally not listed as
    # spp:declaredDependency because the rule documented at §2.3 of
    # this file restricts that field to [workspace.dependencies]
    # members. They are recorded here as a free-form note so that a
    # reader of the plan can still see that `uslng` is a watch-capable
    # REPL, not only a parse/check tool. If a future revision relaxes
    # the §2.3 rule, the right move is to add notify and rustyline to
    # the workspace's [workspace.dependencies] block and then to this
    # component's declaredDependency list — not to bypass the rule.
    #
    # The CLI also depends (at the [dependencies] level) on every
    # in-workspace emitter adapter — usl-ng-emit-{avro, graphql,
    # json-schema, openapi, prisma, protobuf, pydantic, shacl,
    # sql-postgres, typecarta, typescript, zod} — so that each
    # emitter's `DESCRIPTOR` is link-visible to src/registry.rs.
    # Those edges are intra-workspace and recorded as PlannedLinks
    # rather than declaredDependency entries (per §2.3).

uslng:c-emit-common
    a spp:Component ;
    rdfs:label "usl-ng-emit-common"@en ;
    spp:componentName "usl-ng-emit-common" ;
    spp:moduleRole sppc:mr-port ;
    spp:declaredDependency uslng:dep-serde ,
                           uslng:dep-serde-json ,
                           uslng:dep-thiserror ,
                           uslng:dep-miette ,
                           uslng:dep-oxrdf .
    # Defines the emitter contract (signature, loss, family, canonical,
    # bidir, sig_gate, refinement, runtime_context); a "port" in the
    # hexagonal sense to which every target crate is the adapter.
    # oxrdf is here (not only in c-emit-shacl) because the canonical
    # module exposes an RDFC-1.0 canonicaliser for SHACL via the rdfc-10
    # feature, used by the port-level contract.

uslng:c-emit-contract-tests
    a spp:Component ;
    rdfs:label "usl-ng-emit-contract-tests"@en ;
    spp:componentName "usl-ng-emit-contract-tests" ;
    spp:moduleRole sppc:mr-utility .
    # Cross-target conformance harness; asserts every adapter honours
    # the emit-common contract. serde_json appears only under
    # [dev-dependencies] of this crate, so it is intentionally not
    # listed as a declaredDependency (§2.3 rule).

# --- 2.1 Emitter adapters (one per projection target) ---

uslng:c-emit-avro
    a spp:Component ;
    rdfs:label "usl-ng-emit-avro"@en ;
    spp:componentName "usl-ng-emit-avro" ;
    spp:moduleRole sppc:mr-adapter ;
