uslng:link-contract-tests-uses-emit-common
    a spp:PlannedLink ;
    spp:linkSource uslng:c-emit-contract-tests ;
    spp:linkTarget uslng:c-emit-common ;
    spp:plannedLinkRelation sppc:pl-uses .
    # Coverage caveat (verified at commit 293d08d): the harness's
    # [dependencies] in crates/usl-ng-emit-contract-tests/Cargo.toml
    # name 11 emitter adapters — avro, graphql, json-schema, openapi,
    # prisma, protobuf, pydantic, shacl, sql-postgres, typescript, zod
    # — but *not* usl-ng-emit-typecarta. Until that dependency is
    # added, the trait-contract assertions only cover those 11
    # adapters at link-time. The aspirational scope ("every adapter")
    # is recorded in the spp:testCategory tc-contract block.
