# =============================================================================
# 3. ARCHITECTURAL DECISIONS
# =============================================================================

uslng:adr-ast-source-of-truth
    a spp:ArchitecturalDecision ;
    rdfs:label "§4 AST is the source of truth; every other artifact is a declared projection"@en ;
    dct:description """Per PURPOSE.md: 'A single typed core — the §4 AST
        and its semantics — is the source of truth. Every downstream
        artifact is a declared projection of that core, carrying an
        explicit signature (f_i, ℓ_i, (cov_i, fam_i), Γ_{T_i}, can_i, ι_i).'"""@en ;
    spp:decisionKind sppc:decision-kind-existence ;
    spp:decisionForce sppc:force-technical ;
    spp:reversibilityClass sppt:T0 ;
    spp:decisionStatus sppc:ads-accepted ;
    spp:decisionTargetKind sppc:dtk-system ,
                           sppc:dtk-data-model ;
    spp:decisionConsequenceKind sppc:dck-maintainability .

uslng:adr-emitter-port-decomposition
    a spp:ArchitecturalDecision ;
    rdfs:label "Emitter port is the seven-module decomposition (signature, loss, family, canonical, bidir, sig_gate, refinement)"@en ;
    dct:description """The usl-ng-emit-common crate is the architectural
        port to which every target adapter binds. Its surface decomposes
        the projection contract into seven modules that mirror the
        components of the signature tuple from PURPOSE.md:
        `signature` (the (f_i, ℓ_i, cov_i, fam_i, Γ_{T_i}, can_i, ι_i)
        record), `loss` (the per-former LossRows decomposition),
        `family` (faithful / sound-not-complete / complete-not-sound /
        lossy), `canonical` (per-target can_i), `bidir` (BidirClass
        — Lens / WellBehaved / GetOnly / Prism), `sig_gate`
        (refusal hook on shape-mismatch), `refinement` (Phase-G
        invariant lifting). The decomposition is binding: a new
        adapter cannot use a subset; UEP-1001 §S.1 names this set as
        the trait surface every projection plugin must implement.

        Recorded separately from adr-ast-source-of-truth because the
        *existence* of a single core (T0) is reversible only by
        rewriting the project, whereas the *decomposition shape* of
        the port (T1) is reversible by a coordinated refactor without
        invalidating the spec or the proof tree."""@en ;
    spp:decisionKind sppc:decision-kind-existence ;
    spp:decisionForce sppc:force-technical ;
    spp:reversibilityClass sppt:T1 ;
    spp:decisionStatus sppc:ads-accepted ;
    spp:decisionTargetKind sppc:dtk-interface ;
    spp:decisionConsequenceKind sppc:dck-maintainability .

uslng:adr-declared-loss-not-implied
    a spp:ArchitecturalDecision ;
    rdfs:label "Loss must be declared, not implied"@en ;
    dct:description """Per PURPOSE.md: every projection MUST publish an
        explicit loss signature `ℓ_i` decomposed into per-former rows
        per the §6.7.3 sound/complete decomposition. Emitting an
        artifact without a declared loss table is rejected at the
        contract-test level (usl-ng-emit-contract-tests) and at the
        ingest level by UEP-0002 §C.8 (declared-loss completeness).
        'Best effort' emission is not authorised: an adapter that
        cannot decompose its loss is non-conformant, not lossy-but-
        usable.

        Distinct from adr-ast-source-of-truth (which names the core)
        and from adr-emitter-port-decomposition (which names the
        port's shape): this ADR records the *epistemic commitment*
        that loss is a first-class artifact, not a side effect. Force
        is technical because the discipline is what makes the §9.11
        mechanization-status table possible at all."""@en ;
    spp:decisionKind sppc:decision-kind-property ;
    spp:decisionForce sppc:force-technical ;
    spp:reversibilityClass sppt:T0 ;
    spp:decisionStatus sppc:ads-accepted ;
    spp:decisionTargetKind sppc:dtk-system ,
                           sppc:dtk-data-model ;
    spp:decisionConsequenceKind sppc:dck-maintainability .

uslng:adr-pure-addition
    a spp:ArchitecturalDecision ;
    rdfs:label "Pure-addition discipline for spec and surface evolution"@en ;
    dct:description """The spec and surface both follow a pure-addition
        discipline: a Core model that does not exercise a newly added
        construct is behaviorally identical across versions."""@en ;
    spp:decisionKind sppc:decision-kind-property ;
    spp:decisionForce sppc:force-technical ;
    spp:reversibilityClass sppt:T1 ;
    spp:decisionStatus sppc:ads-accepted ;
    spp:decisionTargetKind sppc:dtk-system ;
    spp:decisionConsequenceKind sppc:dck-maintainability .

uslng:adr-wildcard-deny-lint
    a spp:ArchitecturalDecision ;
    rdfs:label "wildcard_enum_match_arm = deny enforces the pure-addition discipline"@en ;
    dct:description """Workspace-level clippy lint forbids `_ =>` arms
        when matching on the AST's spec-bearing enums (Type, Pattern,
        Literal, PrimName, TimeUnit, BinOp, UnaryOp, L8Family,
        ShapeContent, InvariantScope, Temporal). A new variant therefore
        cannot silently fall through existing match arms — it must
        either add an explicit arm or carry a cited #[allow] per
        CLAUDE.md Rule 10.

        This is the mechanical realisation of adr-pure-addition; it is
        recorded separately because the choice of *enforcement
        mechanism* is independently reversible from the *discipline*."""@en ;
    spp:decisionKind sppc:decision-kind-executive ;
    spp:decisionForce sppc:force-technical ;
    spp:reversibilityClass sppt:T3 ;
    spp:decisionStatus sppc:ads-accepted ;
    spp:decisionTargetKind sppc:dtk-system ;
    spp:decisionConsequenceKind sppc:dck-maintainability .

uslng:adr-no-mathlib
    a spp:ArchitecturalDecision ;
    rdfs:label "Lean 4 mechanization pinned to v4.12.0 with no Mathlib dependency"@en ;
    dct:description """The proof tree builds on stock Lean 4.12.0 only,
        with no Mathlib import. This keeps the audit surface minimal at
        the cost of reconstructing standard results in-tree."""@en ;
    spp:decisionKind sppc:decision-kind-ban ;
    spp:decisionForce sppc:force-technical ;
    spp:reversibilityClass sppt:T2 ;
    spp:decisionStatus sppc:ads-accepted ;
    spp:decisionTargetKind sppc:dtk-subsystem ;
    spp:decisionConsequenceKind sppc:dck-maintainability .

