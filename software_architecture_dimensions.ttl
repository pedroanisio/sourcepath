arch:ConcretionExposedEncapsulation a arch:ClassificationValue ; skos:prefLabel "concretion-exposed encapsulation"@en .
arch:PluginComposition a arch:ClassificationValue ; skos:prefLabel "plugin composition"@en .
arch:LibraryComposition a arch:ClassificationValue ; skos:prefLabel "library composition"@en .
arch:GeneratedCodeComposition a arch:ClassificationValue ; skos:prefLabel "generated-code composition"@en .
arch:SemanticVersionEvolution a arch:ClassificationValue ; skos:prefLabel "semantic-version evolution"@en .
arch:ExpandContractMigration a arch:ClassificationValue ; skos:prefLabel "expand-contract migration"@en .
arch:FeatureFlagVariability a arch:ClassificationValue ; skos:prefLabel "feature-flag variability"@en .
arch:ProductLineVariability a arch:ClassificationValue ; skos:prefLabel "product-line variability"@en .
arch:TenantSpecificVariability a arch:ClassificationValue ; skos:prefLabel "tenant-specific variability"@en .
arch:UnitIntegrationE2EPortfolio a arch:ClassificationValue ; skos:prefLabel "unit/integration/e2e verification portfolio"@en .
arch:FormalVerificationAssurance a arch:ClassificationValue ; skos:prefLabel "formal verification assurance"@en .
arch:RuntimeInvariantAssurance a arch:ClassificationValue ; skos:prefLabel "runtime invariant assurance"@en .
arch:ObjectOrientedParadigm a arch:ClassificationValue ; skos:prefLabel "object-oriented paradigm"@en .
