arch:TrunkBasedDeliveryModel a arch:ClassificationValue ; skos:prefLabel "trunk-based delivery model"@en .

arch:D01_DecompositionModel arch:hasClassificationValue arch:ByLayer, arch:ByFeature, arch:ByBoundedContext .
arch:D02_DependencyTopology arch:hasClassificationValue arch:StrictLayeredDependencies, arch:DAGDependencies, arch:CyclicDependencies .
arch:D03_ConnectorAndInteractionModel arch:hasClassificationValue arch:DirectCallConnector, arch:MessageQueueConnector, arch:PubSubConnector, arch:StreamConnector, arch:ActorMailboxConnector .
arch:D04_InterfaceAndContractModel arch:hasClassificationValue arch:SchemaFirstContract, arch:CodeFirstContract, arch:ImplicitContract .
arch:D05_StateAndDataOwnershipModel arch:hasClassificationValue arch:SharedDatabaseOwnership, arch:SingleWriterOwnership, arch:EventSourcedOwnership .
arch:D06_RuntimeExecutionModel arch:hasClassificationValue arch:SingleThreadedRuntime, arch:ThreadPerRequestRuntime, arch:EventLoopRuntime, arch:ActorRuntime, arch:BatchRuntime, arch:AgenticLoopRuntime .
arch:D07_DeploymentAndDistributionModel arch:hasClassificationValue arch:SingleNodeDeployment, arch:ContainerOrchestratedDeployment, arch:ServerlessDeployment, arch:PackageRegistryDistribution .
arch:D08_CodebasePhysicalOrganization arch:hasClassificationValue arch:MonorepoOrganization, arch:PolyrepoOrganization, arch:PackageByFeatureLayout .
arch:D09_AbstractionAndEncapsulationModel arch:hasClassificationValue arch:OpaqueModuleEncapsulation, arch:ConcretionExposedEncapsulation .
arch:D10_CompositionAndReuseModel arch:hasClassificationValue arch:PluginComposition, arch:LibraryComposition, arch:GeneratedCodeComposition .
arch:D11_ChangeAndEvolutionModel arch:hasClassificationValue arch:SemanticVersionEvolution, arch:ExpandContractMigration .
arch:D12_VariabilityAndConfigurationSpaceModel arch:hasClassificationValue arch:FeatureFlagVariability, arch:ProductLineVariability, arch:TenantSpecificVariability .
arch:D13_VerificationAndAssuranceModel arch:hasClassificationValue arch:UnitIntegrationE2EPortfolio, arch:FormalVerificationAssurance, arch:RuntimeInvariantAssurance .
arch:D14_ProgrammingParadigmModel arch:hasClassificationValue arch:ObjectOrientedParadigm, arch:FunctionalParadigm, arch:ProceduralParadigm, arch:DeclarativeParadigm, arch:AgenticLoopParadigm .
arch:D15_ImplementationIdiomStyleModel arch:hasClassificationValue arch:IdiomaticImplementation, arch:UnidiomaticImplementation .
arch:D16_ErrorHandlingAndRecoveryModel arch:hasClassificationValue arch:ExceptionErrorModel, arch:ResultErrorModel, arch:SupervisorRecoveryModel .
arch:D17_TypeAndDataDiscipline arch:hasClassificationValue arch:StaticTypeDiscipline, arch:RuntimeSchemaDiscipline, arch:StringlyTypedDiscipline .
arch:D18_OperationalObservabilityAndControlModel arch:hasClassificationValue arch:LogsMetricsTracesObservability, arch:FeatureFlagControl .
arch:D19_SecurityAndTrustBoundaryModel arch:hasClassificationValue arch:PerimeterSecurityModel, arch:ZeroTrustModel, arch:TenantIsolationModel .
arch:D20_BuildAndDeliveryModel arch:hasClassificationValue arch:HermeticBuildModel, arch:ManualReleaseModel, arch:TrunkBasedDeliveryModel .

#################################################################
# SHACL shapes
#################################################################

arch:CoreSystemDimensionShape
    a sh:NodeShape ;
    sh:targetClass arch:CoreSystemDimension ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "Every core system dimension must have exactly one preferred label."
    ] ;
    sh:property [
        sh:path arch:position ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 20 ;
        sh:message "Every core system dimension must have a position between 1 and 20."
    ] ;
    sh:property [
        sh:path arch:hasCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class arch:DimensionCategory ;
        sh:message "Every core system dimension must belong to exactly one category."
    ] ;
    sh:property [
        sh:path arch:definition ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 20 ;
        sh:message "Every core system dimension must have a substantive definition."
    ] ;
    sh:property [
        sh:path arch:unitOfAnalysis ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every core system dimension must state its unit of analysis."
    ] ;
    sh:property [
        sh:path arch:measures ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every core system dimension must state what it measures."
    ] ;
    sh:property [
        sh:path arch:doesNotMeasure ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every core system dimension must state what it explicitly does not measure."
    ] ;
    sh:property [
        sh:path arch:orthogonalityRationale ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every core system dimension must explain why it is orthogonal."
    ] ;
    sh:property [
        sh:path arch:diagnosticValue ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every core system dimension must state diagnostic value."
    ] ;
    sh:property [
        sh:path arch:failureMode ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every core system dimension must list at least one failure mode."
    ] ;
    sh:property [
        sh:path arch:hasObservableEvidence ;
        sh:minCount 2 ;
        sh:class arch:SystemArtifact ;
        sh:message "Every core system dimension must identify at least two observable evidence artifact types."
    ] ;
    sh:property [
        sh:path arch:hasClassificationValue ;
        sh:minCount 2 ;
        sh:class arch:ClassificationValue ;
        sh:message "Every core system dimension must define at least two classification values."
    ] .

arch:AssessmentOverlayShape
    a sh:NodeShape ;
    sh:targetClass arch:AssessmentOverlay ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "Every assessment overlay must have exactly one preferred label."
    ] ;
    sh:property [
        sh:path arch:definition ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 20 ;
        sh:message "Every assessment overlay must have a substantive definition."
    ] ;
    sh:property [
        sh:path arch:measures ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every assessment overlay must state what it measures or reads across."
    ] ;
    sh:property [
        sh:path arch:doesNotMeasure ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every assessment overlay must state why it is not a core dimension."
    ] .

arch:ScopeAFrameworkShape
    a sh:NodeShape ;
    sh:targetNode arch:ScopeAFramework ;
    sh:property [
        sh:path arch:hasDimension ;
        sh:minCount 20 ;
        sh:maxCount 20 ;
        sh:class arch:CoreSystemDimension ;
        sh:message "The Scope A framework must contain exactly 20 core system dimensions."
    ] ;
    sh:property [
        sh:path arch:hasAssessmentOverlay ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class arch:AssessmentOverlay ;
        sh:message "The Scope A framework must contain exactly one assessment overlay."
    ] ;
    sh:property [
        sh:path arch:scopeRule ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The Scope A framework must define the admission rule for Scope A concepts."
    ] .

arch:DimensionApplicationShape
    a sh:NodeShape ;
    sh:targetClass arch:DimensionApplication ;
    sh:property [
        sh:path arch:classifiesSystem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class arch:SoftwareSystem ;
        sh:message "A dimension application must classify exactly one software system."
    ] ;
    sh:property [
        sh:path arch:appliesDimension ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class arch:CoreSystemDimension ;
        sh:message "A dimension application must apply exactly one core system dimension."
    ] ;
    sh:property [
        sh:path arch:usesClassificationValue ;
        sh:class arch:ClassificationValue ;
        sh:message "Every used classification value must be typed arch:ClassificationValue."
    ] ;
    sh:property [
        sh:path arch:dominantValue ;
        sh:maxCount 1 ;
        sh:class arch:ClassificationValue ;
        sh:message "A dimension application may name at most one dominant classification value."
    ] ;
    sh:or (
        [ sh:property [ sh:path arch:usesClassificationValue ; sh:minCount 1 ] ]
        [ sh:property [ sh:path arch:confidenceLevel ; sh:hasValue "Unknown" ] ]
    ) ;
    sh:message "A dimension application must use at least one classification value, unless its confidence is Unknown (in which case the evidence summary states what evidence would settle the classification)." ;
    sh:property [
        sh:path arch:supportedByEvidence ;
        sh:minCount 1 ;
        sh:class arch:EvidenceRecord ;
        sh:message "A dimension application must be supported by at least one evidence record."
    ] ;
    sh:property [
        sh:path arch:confidenceLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "High" "Medium" "Low" "Unknown" ) ;
        sh:message "A dimension application must declare confidence as High, Medium, Low, or Unknown."
    ] .

arch:EvidenceRecordShape
    a sh:NodeShape ;
    sh:targetClass arch:EvidenceRecord ;
    sh:property [
        sh:path arch:evidenceSummary ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 10 ;
        sh:message "An evidence record must include an evidence summary."
    ] .

arch:QualityOverlayNotCoreDimensionShape
    a sh:NodeShape ;
    sh:targetNode arch:O01_QualityAttributePrioritizationProfile ;
    sh:not [ sh:class arch:CoreSystemDimension ] ;
    sh:message "Quality attribute prioritization profile must remain an assessment overlay, not a core system dimension." .

arch:ConnectorDimensionRequiredShape
    a sh:NodeShape ;
    sh:targetNode arch:ScopeAFramework ;
    sh:property [
        sh:path arch:hasDimension ;
        sh:hasValue arch:D03_ConnectorAndInteractionModel ;
        sh:message "Scope A must include Connector and Interaction Model as a core dimension."
    ] .

arch:VariabilityDimensionRequiredShape
    a sh:NodeShape ;
    sh:targetNode arch:ScopeAFramework ;
    sh:property [
        sh:path arch:hasDimension ;
        sh:hasValue arch:D12_VariabilityAndConfigurationSpaceModel ;
        sh:message "Scope A must include Variability and Configuration-Space Model as a core dimension."
    ] .

arch:ParadigmIdiomSplitShape
    a sh:NodeShape ;
    sh:targetNode arch:ScopeAFramework ;
    sh:property [
        sh:path arch:hasDimension ;
        sh:hasValue arch:D14_ProgrammingParadigmModel ;
        sh:message "Scope A must include Programming Paradigm Model separately from implementation idiom/style."
    ] ;
    sh:property [
        sh:path arch:hasDimension ;
        sh:hasValue arch:D15_ImplementationIdiomStyleModel ;
        sh:message "Scope A must include Implementation Idiom and Style Model separately from programming paradigm."
    ] .

arch:VerificationAssuranceRequiredShape
    a sh:NodeShape ;
    sh:targetNode arch:ScopeAFramework ;
    sh:property [
        sh:path arch:hasDimension ;
        sh:hasValue arch:D13_VerificationAndAssuranceModel ;
        sh:message "Scope A must use the broader Verification and Assurance Model instead of a pre-release-only testing model."
    ] .

arch:PositionUniquenessShape
    a sh:NodeShape ;
    sh:targetClass arch:CoreSystemDimension ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Two core system dimensions must not share the same position." ;
        sh:prefixes arch:ScopeACoreSystemDimensionsOntology ;
        sh:select """
            SELECT $this
            WHERE {
                $this arch:position ?p .
                ?other arch:position ?p .
                FILTER (?other != $this)
            }
        """ ;
    ] .

arch:ValueBelongsToDimensionShape
    a sh:NodeShape ;
    sh:targetClass arch:DimensionApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A dimension application must only use classification values that its applied dimension declares via arch:hasClassificationValue; ABoxes minting new values must register them on the dimension." ;
        sh:prefixes arch:ScopeACoreSystemDimensionsOntology ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this arch:appliesDimension ?dim .
                $this arch:usesClassificationValue ?value .
                FILTER NOT EXISTS { ?dim arch:hasClassificationValue ?value . }
            }
        """ ;
    ] .
