{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recipe-forge.local/schema/backlog-1.0.0.json",
  "title": "Backlog governance registry",
  "description": "Structure for a deferred-work backlog. Every item must trace to a real, verifiable source. Effort is complexity, not time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["disclaimer", "metadata", "items"],
  "properties": {
    "disclaimer": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "generated_by", "generated_on", "system_of_record", "total_items", "id_prefix", "decision_prefix", "categories", "types", "statuses", "complexities", "priorities", "owners"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "generated_by": { "type": "string", "minLength": 1 },
        "generated_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "system_of_record": { "type": "string", "minLength": 1 },
        "total_items": { "type": "integer", "minimum": 0 },
        "id_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,8}$" },
        "decision_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,8}$" },
        "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["feature","docs","ops","security","testing","tooling"] } },
        "types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["feature","tech-debt","bug","infra","research"] } },
        "statuses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["parked","ready","blocked","in-progress","done"] } },
        "complexities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["XS","S","M","L","XL"] } },
        "priorities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["low","medium","high","critical"] } },
        "owners": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["mine","concurrent","shared","unassigned"] } }
      }
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/backlogItem" } }
  },
  "$defs": {
    "backlogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "category", "type", "status", "complexity", "priority", "rationale", "source", "owner"],
      "properties": {
        "id": { "type": "string", "pattern": "^BL-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 3 },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["feature","docs","ops","security","testing","tooling"] },
        "type": { "type": "string", "enum": ["feature","tech-debt","bug","infra","research"] },
        "status": { "type": "string", "enum": ["parked","ready","blocked","in-progress","done"] },
        "complexity": { "type": "string", "enum": ["XS","S","M","L","XL"] },
        "priority": { "type": "string", "enum": ["low","medium","high","critical"] },
        "rationale": { "type": "string", "minLength": 1 },
        "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^BL-[0-9]{3}$" } },
        "related_decisions": { "type": "array", "items": { "type": "string", "pattern": "^D-[0-9]{3}$" } },
        "references": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": { "type": "string", "enum": ["file-exists", "file-absent", "grep"] },
              "path": { "type": "string", "minLength": 1 },
              "pattern": { "type": "string" },
              "expect": { "type": "boolean" }
            }
          }
        },
        "owner": { "type": "string", "enum": ["mine","concurrent","shared","unassigned"] },
        "source": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
