sppc:td-build           a skos:Concept ; skos:inScheme sppc:technical-debt-type ; skos:prefLabel "Build debt"@en .
sppc:td-defect          a skos:Concept ; skos:inScheme sppc:technical-debt-type ; skos:prefLabel "Defect debt"@en .
sppc:td-infrastructure  a skos:Concept ; skos:inScheme sppc:technical-debt-type ; skos:prefLabel "Infrastructure debt"@en .
