# =============================================================================
# 6. DECISION KIND — Kruchten 2004
# =============================================================================

sppc:decision-kind a skos:ConceptScheme ;
    dct:title "Kruchten decision kinds"@en ;
    spp:axisPosition spp:axisConcern ;
    spp:tier sppt:T1 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:kruchten-2004 ;
    # Naming exception (v4.1.0): concepts in this scheme use the full
    # `decision-kind-*` prefix rather than the short two-letter form
    # used by other schemes (e.g. `vis-public`, `ap-monolith`). The
    # natural short form `dk-*` is already taken by dependency-kind
    # (dk-runtime, dk-build, dk-dev, …). Renaming dependency-kind to
    # free up `dk-` would be a breaking change for all existing
    # consumers, so decision-kind retains its long form. The
    # reversibility-tier scheme has its own `sppt:` namespace and is
    # not affected.
    skos:hasTopConcept sppc:decision-kind-existence ,
                       sppc:decision-kind-property ,
                       sppc:decision-kind-executive ,
                       sppc:decision-kind-ban .

sppc:decision-kind-existence a skos:Concept ;
    skos:inScheme sppc:decision-kind ;
    skos:prefLabel "Existence decision (ontocrise)"@en ;
    skos:definition "Some element/artifact will exist."@en .

sppc:decision-kind-property a skos:Concept ;
    skos:inScheme sppc:decision-kind ;
    skos:prefLabel "Property decision (diacrise)"@en ;
    skos:definition "An enduring quality, trait, or guideline of the system."@en .

sppc:decision-kind-executive a skos:Concept ;
    skos:inScheme sppc:decision-kind ;
    skos:prefLabel "Executive decision (pericrise)"@en ;
    skos:definition "Process / organisation / methodology / technology decision enabling the design."@en .

sppc:decision-kind-ban a skos:Concept ;
    skos:inScheme sppc:decision-kind ;
    skos:prefLabel "Ban (non-existence decision)"@en ;
    skos:definition "Explicit choice that something will NOT exist."@en .

# =============================================================================
# 7. DECISION FORCES — van Heesch et al. 2012 forces viewpoint
# =============================================================================

sppc:decision-force a skos:ConceptScheme ;
    dct:title "Decision force kind"@en ;
    spp:axisPosition spp:axisConcern ;
    spp:tier sppt:T1 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:vanheesch-2012-forces , sppsrc:iso42010-2022 ;
    skos:hasTopConcept sppc:force-business ,
        sppc:force-economic ,
        sppc:force-organisational ,
        sppc:force-regulatory ,
        sppc:force-technical ,
        sppc:force-user .

sppc:force-business      a skos:Concept ; skos:inScheme sppc:decision-force ; skos:prefLabel "Business force"@en .
sppc:force-technical     a skos:Concept ; skos:inScheme sppc:decision-force ; skos:prefLabel "Technical force"@en .
sppc:force-regulatory    a skos:Concept ; skos:inScheme sppc:decision-force ; skos:prefLabel "Regulatory force"@en .
sppc:force-organisational a skos:Concept ; skos:inScheme sppc:decision-force ; skos:prefLabel "Organisational force"@en .
sppc:force-user          a skos:Concept ; skos:inScheme sppc:decision-force ; skos:prefLabel "User force"@en .
sppc:force-economic      a skos:Concept ; skos:inScheme sppc:decision-force ; skos:prefLabel "Economic force"@en .

# =============================================================================
# 8. CATEGORICAL VOCABULARIES (the heart of the schema)
# =============================================================================
#
# For each concept scheme:
#   - dct:title
#   - spp:axisPosition (axisConcern | axisPhase | axisScope | axisExternality)
#   - spp:tier (sppt:T0 ... sppt:T3)
#   - spp:groundingStatus (FORMALLY | PARTIALLY | PRACTITIONER_ONLY)
#   - spp:groundedIn (one or more grounding sources)
#   - skos:hasTopConcept for each value
#
# Concept values are minimal — skos:prefLabel only; further sub-characteristics
# (skos:broader / skos:narrower) are not exhaustively elaborated here but the
# pattern is set.
# =============================================================================

# --- 8.1 Tenancy (T0, ADDED per research) ---
sppc:tenancy-model a skos:ConceptScheme ;
    dct:title "Tenancy Model"@en ;
    rdfs:comment "ADDED in v4.0 per research Part 3.1. Article §4 names tenancy as canonical Tier-0."@en ;
    spp:axisPosition spp:axisConcern ;
    spp:tier sppt:T0 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:bezemer-zaidman-2010 , sppsrc:kabbedijk-2015 ;
    skos:hasTopConcept sppc:tenancy-fully-pooled ,
        sppc:tenancy-shared-app-dedicated-db ,
        sppc:tenancy-shared-app-shared-db-schema ,
        sppc:tenancy-single .

sppc:tenancy-single                      a skos:Concept ; skos:inScheme sppc:tenancy-model ; skos:prefLabel "Single-tenant"@en .
sppc:tenancy-shared-app-dedicated-db     a skos:Concept ; skos:inScheme sppc:tenancy-model ; skos:prefLabel "Shared app, dedicated database per tenant"@en .
sppc:tenancy-shared-app-shared-db-schema a skos:Concept ; skos:inScheme sppc:tenancy-model ; skos:prefLabel "Shared app, shared DB, separate schemas"@en .
sppc:tenancy-fully-pooled                a skos:Concept ; skos:inScheme sppc:tenancy-model ; skos:prefLabel "Fully pooled (shared schema with tenant ID)"@en .

# --- 8.2 Authentication Mechanism (T0/T1, ADDED) ---
sppc:authentication-mechanism a skos:ConceptScheme ;
    dct:title "Authentication Mechanism"@en ;
    rdfs:comment "ADDED in v4.0 per research Part 3.2."@en ;
    spp:axisPosition spp:axisConcern ;
    spp:tier sppt:T1 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:rfc6749 , sppsrc:oidc-core-1 , sppsrc:saml2 ,
                   sppsrc:rfc7519 , sppsrc:rfc8446 , sppsrc:webauthn-2 ,
                   sppsrc:nist-800-63b ;
    skos:hasTopConcept sppc:auth-api-key ,
        sppc:auth-jwt-bearer ,
        sppc:auth-mtls ,
        sppc:auth-oauth2 ,
        sppc:auth-oidc ,
        sppc:auth-password ,
        sppc:auth-saml2 ,
        sppc:auth-session ,
        sppc:auth-webauthn .

sppc:auth-password   a skos:Concept ; skos:inScheme sppc:authentication-mechanism ; skos:prefLabel "Password (memorised secret)"@en .
sppc:auth-oauth2     a skos:Concept ; skos:inScheme sppc:authentication-mechanism ; skos:prefLabel "OAuth 2.0"@en .
sppc:auth-oidc       a skos:Concept ; skos:inScheme sppc:authentication-mechanism ; skos:prefLabel "OpenID Connect"@en .
sppc:auth-saml2      a skos:Concept ; skos:inScheme sppc:authentication-mechanism ; skos:prefLabel "SAML 2.0"@en .
sppc:auth-mtls       a skos:Concept ; skos:inScheme sppc:authentication-mechanism ; skos:prefLabel "Mutual TLS"@en .
sppc:auth-jwt-bearer a skos:Concept ; skos:inScheme sppc:authentication-mechanism ; skos:prefLabel "JWT bearer"@en .
sppc:auth-api-key    a skos:Concept ; skos:inScheme sppc:authentication-mechanism ; skos:prefLabel "API Key"@en .
sppc:auth-session    a skos:Concept ; skos:inScheme sppc:authentication-mechanism ; skos:prefLabel "Session (cookie-based)"@en .
sppc:auth-webauthn   a skos:Concept ; skos:inScheme sppc:authentication-mechanism ; skos:prefLabel "WebAuthn / FIDO2"@en .

# --- 8.3 Idempotency Policy (T1, ADDED) ---
sppc:idempotency-policy a skos:ConceptScheme ;
    dct:title "Idempotency Policy"@en ;
    rdfs:comment "ADDED in v4.0 per research Part 3.3."@en ;
    spp:axisPosition spp:axisConcern ;
    spp:tier sppt:T1 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:helland-2012 , sppsrc:kleppmann-ddia ;
    skos:hasTopConcept sppc:idem-at-least-once ,
        sppc:idem-at-most-once ,
        sppc:idem-compensable ,
        sppc:idem-exactly-once ,
        sppc:idem-idempotent-by-key .

sppc:idem-at-most-once         a skos:Concept ; skos:inScheme sppc:idempotency-policy ; skos:prefLabel "At-most-once"@en .
sppc:idem-at-least-once        a skos:Concept ; skos:inScheme sppc:idempotency-policy ; skos:prefLabel "At-least-once"@en .
sppc:idem-exactly-once         a skos:Concept ; skos:inScheme sppc:idempotency-policy ; skos:prefLabel "Exactly-once (via dedup + transactional log)"@en .
sppc:idem-idempotent-by-key    a skos:Concept ; skos:inScheme sppc:idempotency-policy ; skos:prefLabel "Idempotent by key"@en .
sppc:idem-compensable          a skos:Concept ; skos:inScheme sppc:idempotency-policy ; skos:prefLabel "Compensable transaction (Saga / TCC)"@en .

# --- 8.4 Concurrency Model (T0, ADDED) ---
sppc:concurrency-model a skos:ConceptScheme ;
    dct:title "Concurrency Model"@en ;
    rdfs:comment "ADDED in v4.0 per research Part 3.4."@en ;
    spp:axisPosition spp:axisConcern ;
    spp:tier sppt:T0 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:hewitt-1973 , sppsrc:hoare-1978 , sppsrc:lee-2006 ;
    skos:hasTopConcept sppc:concurrency-actors ,
        sppc:concurrency-async ,
        sppc:concurrency-csp ,
        sppc:concurrency-event-loop ,
        sppc:concurrency-process ,
        sppc:concurrency-stm ,
        sppc:concurrency-threads .

sppc:concurrency-threads         a skos:Concept ; skos:inScheme sppc:concurrency-model ; skos:prefLabel "Preemptive threads with locks"@en .
sppc:concurrency-async           a skos:Concept ; skos:inScheme sppc:concurrency-model ; skos:prefLabel "Cooperative async / await"@en .
sppc:concurrency-actors          a skos:Concept ; skos:inScheme sppc:concurrency-model ; skos:prefLabel "Actor model"@en .
sppc:concurrency-csp             a skos:Concept ; skos:inScheme sppc:concurrency-model ; skos:prefLabel "CSP / channels"@en .
sppc:concurrency-event-loop      a skos:Concept ; skos:inScheme sppc:concurrency-model ; skos:prefLabel "Single-threaded event loop (Reactor)"@en .
sppc:concurrency-process         a skos:Concept ; skos:inScheme sppc:concurrency-model ; skos:prefLabel "Process-per-request"@en .
sppc:concurrency-stm             a skos:Concept ; skos:inScheme sppc:concurrency-model ; skos:prefLabel "Software Transactional Memory"@en .

# --- 8.5 Caching Strategy (T2, ADDED) ---
sppc:caching-strategy a skos:ConceptScheme ;
    dct:title "Caching Strategy"@en ;
    rdfs:comment "ADDED in v4.0 per research Part 3.5."@en ;
    spp:axisPosition spp:axisConcern ;
    spp:tier sppt:T2 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:smith-1982 , sppsrc:nishtala-2013 , sppsrc:rfc9111 ;
    skos:hasTopConcept sppc:cache-aside ,
        sppc:cache-none ,
        sppc:cache-read-through ,
        sppc:cache-refresh-ahead ,
        sppc:cache-write-around ,
        sppc:cache-write-back ,
        sppc:cache-write-through .

sppc:cache-none           a skos:Concept ; skos:inScheme sppc:caching-strategy ; skos:prefLabel "No cache"@en .
sppc:cache-aside          a skos:Concept ; skos:inScheme sppc:caching-strategy ; skos:prefLabel "Cache-aside (lazy loading)"@en .
sppc:cache-read-through   a skos:Concept ; skos:inScheme sppc:caching-strategy ; skos:prefLabel "Read-through"@en .
sppc:cache-write-through  a skos:Concept ; skos:inScheme sppc:caching-strategy ; skos:prefLabel "Write-through"@en .
sppc:cache-write-back     a skos:Concept ; skos:inScheme sppc:caching-strategy ; skos:prefLabel "Write-behind / write-back"@en .
sppc:cache-write-around   a skos:Concept ; skos:inScheme sppc:caching-strategy ; skos:prefLabel "Write-around"@en .
sppc:cache-refresh-ahead  a skos:Concept ; skos:inScheme sppc:caching-strategy ; skos:prefLabel "Refresh-ahead"@en .

# --- 8.6 ISO 25010:2023 Quality Characteristics (T0/T1 cross-cutting concerns) ---
sppc:quality-characteristic a skos:ConceptScheme ;
    dct:title "ISO/IEC 25010:2023 Quality Characteristics"@en ;
    rdfs:comment "Nine top-level characteristics from 2023 edition. Renames from 2011 verified: Usability → Interaction Capability; Portability → Flexibility (with Scalability added); Maturity → Faultlessness; Safety added; Resistance added under Security."@en ;
    spp:axisPosition spp:axisConcern ;
    spp:tier sppt:T1 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:iso25010-2023 ;
    skos:hasTopConcept sppc:qc-compatibility ,
        sppc:qc-flexibility ,
        sppc:qc-functional-suitability ,
        sppc:qc-interaction-capability ,
        sppc:qc-maintainability ,
        sppc:qc-performance-efficiency ,
        sppc:qc-reliability ,
        sppc:qc-safety ,
        sppc:qc-security .

sppc:qc-functional-suitability    a skos:Concept ; skos:inScheme sppc:quality-characteristic ; skos:prefLabel "Functional Suitability"@en .
sppc:qc-performance-efficiency    a skos:Concept ; skos:inScheme sppc:quality-characteristic ; skos:prefLabel "Performance Efficiency"@en .
sppc:qc-compatibility             a skos:Concept ; skos:inScheme sppc:quality-characteristic ; skos:prefLabel "Compatibility"@en .
sppc:qc-interaction-capability    a skos:Concept ; skos:inScheme sppc:quality-characteristic ; skos:prefLabel "Interaction Capability"@en ;
    skos:altLabel "Usability (deprecated 25010:2011 label)"@en .
sppc:qc-reliability               a skos:Concept ; skos:inScheme sppc:quality-characteristic ; skos:prefLabel "Reliability"@en .
sppc:qc-security                  a skos:Concept ; skos:inScheme sppc:quality-characteristic ; skos:prefLabel "Security"@en .
sppc:qc-maintainability           a skos:Concept ; skos:inScheme sppc:quality-characteristic ; skos:prefLabel "Maintainability"@en .
sppc:qc-flexibility               a skos:Concept ; skos:inScheme sppc:quality-characteristic ; skos:prefLabel "Flexibility"@en ;
    skos:altLabel "Portability (deprecated 25010:2011 label)"@en .
sppc:qc-safety                    a skos:Concept ; skos:inScheme sppc:quality-characteristic ; skos:prefLabel "Safety"@en .

