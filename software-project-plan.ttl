# =============================================================================
# 9. CORE ENTITY CLASSES
# =============================================================================

spp:SoftwareProjectPlan a owl:Class ;
    rdfs:label "Software Project Plan"@en ;
    rdfs:comment "A plan-time view of a software project. Excludes runtime facts."@en .

spp:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "A constituent module of a project as DECLARED in the plan."@en .

spp:Dependency a owl:Class ;
    rdfs:label "Dependency"@en ;
    rdfs:comment "A declared external dependency. Excludes resolved_version (runtime)."@en .

spp:PlannedEnvironment a owl:Class ;
    rdfs:label "Planned Environment"@en ;
    rdfs:comment "An environment declared in the plan. Excludes is_active (runtime)."@en .

spp:PlannedLink a owl:Class ;
    rdfs:label "Planned Link"@en ;
    rdfs:comment "A declared relationship between components."@en .

spp:ArchitecturalDecision a owl:Class ;
    rdfs:label "Architectural Decision"@en ;
    rdfs:comment "A first-class ADR per ISO/IEC/IEEE 42010:2022 §7.4."@en ;
    rdfs:subClassOf prov:Entity .

spp:Categorical a owl:Class ;
    rdfs:label "Categorical vocabulary"@en ;
    rdfs:comment """A concept scheme that contributes a categorical
        decision vocabulary to the plan. Subclass of skos:ConceptScheme.
        Distinguished from spp:MetaScheme, which describes the framework
        itself rather than a plan-time decision."""@en ;
    rdfs:subClassOf skos:ConceptScheme .

# =============================================================================
# 10. PROPERTIES
# =============================================================================

# --- Object properties ---

spp:groundedIn a owl:ObjectProperty ;
    rdfs:label "grounded in"@en ;
    rdfs:range spp:GroundingSource .
    # v4.1.0: dropped rdfs:domain spp:Categorical. Axes
    # (spp:axisConcern, axisPhase, axisScope, axisExternality) cite
    # sources via spp:groundedIn but are spp:Axis instances, not
    # spp:Categorical. The previous domain falsely promoted them to
    # skos:ConceptScheme under RDFS expansion and required a SPARQL
    # filter exemption in ConceptSchemeMetadataShape to suppress the
    # cascade. Removing the domain assertion eliminates the cause; the
    # SPARQL exemption is retained as defence-in-depth.

spp:tier a owl:ObjectProperty ;
    rdfs:label "reversibility tier"@en ;
    rdfs:range skos:Concept .

spp:axisPosition a owl:ObjectProperty ;
    rdfs:label "axis position"@en ;
    rdfs:range spp:Axis .

spp:groundingStatus a owl:ObjectProperty ;
    rdfs:label "grounding status"@en ;
    rdfs:range skos:Concept .

spp:component a owl:ObjectProperty ;
    rdfs:label "has component"@en ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range spp:Component .

spp:decision a owl:ObjectProperty ;
    rdfs:label "has decision"@en ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range spp:ArchitecturalDecision .

spp:declaredDependency a owl:ObjectProperty ;
    rdfs:label "declared dependency"@en ;
    rdfs:domain spp:Component ;
    rdfs:range spp:Dependency .

# B4: every plan-level categorical property below carries
# rdfs:domain spp:SoftwareProjectPlan so SHACL/OWL reasoners can
# locate where the property applies. Sub-entity-scoped properties
# carry their narrower domain explicitly.
spp:tenancyModel a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:concurrencyModel a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:authenticationMechanism a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:idempotencyPolicy a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:cachingStrategy a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:privacyPosture a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:accessibilityPosture a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:sustainabilityPosture a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:sbomPolicy a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:architecturePattern a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:dataStorageParadigm a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:consistencyModel a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:apiSpecification a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:versioningScheme a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:deploymentStrategy a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:rollbackPolicy a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:branchingStrategy a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:visibility a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:sosType a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:decisionKind a owl:ObjectProperty ; rdfs:domain spp:ArchitecturalDecision ; rdfs:range skos:Concept .
spp:decisionForce a owl:ObjectProperty ; rdfs:domain spp:ArchitecturalDecision ; rdfs:range skos:Concept .
spp:reversibilityClass a owl:ObjectProperty ; rdfs:domain spp:ArchitecturalDecision ; rdfs:range skos:Concept .
spp:technicalDebtType a owl:ObjectProperty ; rdfs:domain spp:ArchitecturalDecision ; rdfs:range skos:Concept .

# --- Object properties added in v4.1 for the exhaustive scheme set ---
spp:projectKind a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:runtimePlatform a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:dependencyKind a owl:ObjectProperty ; rdfs:range skos:Concept ;
    rdfs:domain spp:Dependency .
spp:componentOwnership a owl:ObjectProperty ; rdfs:domain spp:Component ; rdfs:range skos:Concept .
spp:plannedEnvironmentKind a owl:ObjectProperty ; rdfs:range skos:Concept ;
    rdfs:domain spp:PlannedEnvironment .
spp:plannedLinkRelation a owl:ObjectProperty ; rdfs:range skos:Concept ;
    rdfs:domain spp:PlannedLink .
spp:runtimeRelation a owl:ObjectProperty ; rdfs:range skos:Concept ;
    rdfs:domain spp:PlannedLink .
spp:dataRelationCardinality a owl:ObjectProperty ; rdfs:domain spp:PlannedLink ; rdfs:range skos:Concept .
spp:moduleRole a owl:ObjectProperty ; rdfs:range skos:Concept ;
    rdfs:domain spp:Component .
spp:ciCdProvider a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:buildTool a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:containerTool a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:infrastructureTool a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:platformEngineeringPattern a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:cloudTopology a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:monitoringPlatform a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:observabilityPractice a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:testMethodology a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:testCategory a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:testTechnique a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:securityTestingPractice a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:securityModel a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:supplyChainSecurityPractice a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:privacyCompliancePractice a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:processMethodology a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:engineeringPractice a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:complianceLevel a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:documentationApproach a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:aiMlPosture a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:finOpsPosture a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:dataStreamingPattern a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:messagingPlatform a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .

# --- ADR meta-vocab properties ---
spp:decisionStatus a owl:ObjectProperty ; rdfs:range skos:Concept ;
    rdfs:domain spp:ArchitecturalDecision .
spp:decisionOptionStatus a owl:ObjectProperty ; rdfs:domain spp:ArchitecturalDecision ; rdfs:range skos:Concept .
spp:decisionTargetKind a owl:ObjectProperty ; rdfs:range skos:Concept ;
    rdfs:domain spp:ArchitecturalDecision .
spp:decisionConsequenceKind a owl:ObjectProperty ; rdfs:range skos:Concept ;
    rdfs:domain spp:ArchitecturalDecision .

# --- SEMAT Alpha state tracking properties ---
spp:stakeholderAlphaState a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:opportunityAlphaState a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:requirementsAlphaState a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:softwareSystemAlphaState a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:teamAlphaState a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:wayOfWorkingAlphaState a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:workAlphaState a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .

# --- Additional plan-level properties ---
spp:qualityCharacteristic a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:operationalExcellenceArea a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .
spp:maintenanceType a owl:ObjectProperty ; rdfs:domain spp:SoftwareProjectPlan ; rdfs:range skos:Concept .

# --- PlannedEnvironment and PlannedLink composition properties ---
spp:plannedEnvironment a owl:ObjectProperty ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range spp:PlannedEnvironment .
spp:plannedLink a owl:ObjectProperty ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range spp:PlannedLink .

# --- PlannedLink endpoint properties (B2) ---
# A PlannedLink declares a directed relationship between two components.
# Without source/target, a link instance is structurally meaningless.
spp:linkSource a owl:ObjectProperty ;
    rdfs:label "link source component"@en ;
    rdfs:domain spp:PlannedLink ;
    rdfs:range spp:Component .
spp:linkTarget a owl:ObjectProperty ;
    rdfs:label "link target component"@en ;
    rdfs:domain spp:PlannedLink ;
    rdfs:range spp:Component .

# --- Datatype properties ---

spp:planName a owl:DatatypeProperty ;
    rdfs:label "plan name"@en ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range xsd:string .
spp:planVersion a owl:DatatypeProperty ;
    rdfs:label "plan version"@en ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range xsd:string .

# --- Sub-entity identifier properties (B1) ---
# Distinct names for each sub-entity; conflating them with spp:planName
# (the plan's own name) was a category error.
spp:componentName a owl:DatatypeProperty ;
    rdfs:label "component name"@en ;
    rdfs:domain spp:Component ;
    rdfs:range xsd:string .
spp:dependencyName a owl:DatatypeProperty ;
    rdfs:label "dependency name"@en ;
    rdfs:domain spp:Dependency ;
    rdfs:range xsd:string .
spp:environmentName a owl:DatatypeProperty ;
    rdfs:label "environment name"@en ;
    rdfs:domain spp:PlannedEnvironment ;
    rdfs:range xsd:string .

spp:sourceTier a owl:DatatypeProperty ; rdfs:range xsd:string .
spp:groundingQuality a owl:DatatypeProperty ; rdfs:range xsd:string .

# Runtime properties — DEFINED here only to be EXPLICITLY EXCLUDED
# from plan shapes via sh:closed. Their definition is required for
# the disjoint-with assertion below.

spp:currentVersion a owl:DatatypeProperty ;
    rdfs:label "current version (RUNTIME — excluded from plan)"@en .

spp:archivedAt a owl:DatatypeProperty ;
    rdfs:label "archived at (RUNTIME — excluded from plan)"@en .

spp:resolvedVersion a owl:DatatypeProperty ;
    rdfs:label "resolved dependency version (RUNTIME — excluded from plan)"@en .

spp:isActive a owl:DatatypeProperty ;
    rdfs:label "is active (RUNTIME — excluded from plan)"@en .

# =============================================================================
# 11. SHACL SHAPES — validation rules
# =============================================================================

# --- 11.1 Project plan shape (closed; enforces abstraction boundary) ---

sppsh:SoftwareProjectPlanShape a sh:NodeShape ;
    sh:targetClass spp:SoftwareProjectPlan ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment
                           dct:title dct:description dct:created
                           dct:modified dct:conformsTo dct:identifier
                           dct:hasVersion dct:creator dct:license
                           dct:issued ) ;
    rdfs:comment """Closed shape: any property of a plan that is not
        listed here will produce a SHACL Violation. This is how the
        ontology enforces the plan/runtime abstraction boundary —
        properties like spp:currentVersion, spp:archivedAt, etc., are
        deliberately absent from this shape's sh:property list and will
        be rejected by validators."""@en ;

    sh:property [
        sh:path spp:planName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A plan must have exactly one planName."@en ;
    ] ;
    sh:property [
        sh:path spp:planVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path spp:visibility ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:visibility ] ] ;
    ] ;
    sh:property [
        sh:path spp:tenancyModel ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:tenancy-model ] ] ;
        sh:severity sh:Warning ;
        sh:message "Tenancy model is a Tier-0 decision; declare it explicitly."@en ;
    ] ;
    sh:property [
        sh:path spp:concurrencyModel ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:concurrency-model ] ] ;
    ] ;
    sh:property [
        sh:path spp:authenticationMechanism ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:authentication-mechanism ] ] ;
    ] ;
    sh:property [
        sh:path spp:idempotencyPolicy ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:idempotency-policy ] ] ;
    ] ;
    sh:property [
        sh:path spp:cachingStrategy ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:caching-strategy ] ] ;
    ] ;
    sh:property [
        sh:path spp:privacyPosture ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:privacy-posture ] ] ;
        sh:severity sh:Warning ;
        sh:message "Privacy posture is regulatory-bearing (GDPR, ISO 31700); declare it explicitly."@en ;
    ] ;
    sh:property [
        sh:path spp:accessibilityPosture ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:accessibility-posture ] ] ;
    ] ;
    sh:property [
        sh:path spp:sustainabilityPosture ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:sustainability-posture ] ] ;
    ] ;
    sh:property [
        sh:path spp:sbomPolicy ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:sbom-policy ] ] ;
    ] ;
    sh:property [
        sh:path spp:architecturePattern ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:architecture-pattern ] ] ;
    ] ;
    sh:property [
        sh:path spp:dataStorageParadigm ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:data-storage-paradigm ] ] ;
    ] ;
    sh:property [
        sh:path spp:consistencyModel ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:consistency-model ] ] ;
    ] ;
    sh:property [
        sh:path spp:apiSpecification ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:api-specification ] ] ;
    ] ;
    sh:property [
        sh:path spp:versioningScheme ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:versioning-scheme ] ] ;
    ] ;
    sh:property [
        sh:path spp:deploymentStrategy ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:deployment-strategy ] ] ;
    ] ;
    sh:property [
        sh:path spp:rollbackPolicy ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:rollback-policy ] ] ;
    ] ;
    sh:property [
        sh:path spp:branchingStrategy ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:branching-strategy ] ] ;
    ] ;
    sh:property [
        sh:path spp:sosType ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:system-of-systems-type ] ] ;
    ] ;
    sh:property [
        sh:path spp:component ;
        sh:class spp:Component ;
        sh:minCount 1 ;
        sh:message "A plan must declare at least one component."@en ;
    ] ;
    sh:property [
        sh:path spp:decision ;
        sh:class spp:ArchitecturalDecision ;
    ] ;
    # --- Composition properties added in v4.1 ---
    sh:property [
        sh:path spp:plannedEnvironment ;
        sh:class spp:PlannedEnvironment ;
    ] ;
    sh:property [
        sh:path spp:plannedLink ;
        sh:class spp:PlannedLink ;
    ] ;
    # --- Plan-level categorical properties added in v4.1 ---
    sh:property [
        sh:path spp:projectKind ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:project-kind ] ] ;
        sh:severity sh:Warning ;
        sh:message "Project kind is Tier-0; declare it explicitly."@en ;
    ] ;
    sh:property [
        sh:path spp:runtimePlatform ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:runtime-platform ] ] ;
    ] ;
    sh:property [
        sh:path spp:cloudTopology ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:cloud-topology ] ] ;
    ] ;
    sh:property [
        sh:path spp:ciCdProvider ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:ci-cd-provider ] ] ;
    ] ;
    sh:property [
        sh:path spp:buildTool ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:build-tool ] ] ;
    ] ;
    sh:property [
        sh:path spp:containerTool ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:container-tool ] ] ;
    ] ;
    sh:property [
        sh:path spp:infrastructureTool ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:infrastructure-tool ] ] ;
    ] ;
    sh:property [
        sh:path spp:platformEngineeringPattern ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:platform-engineering-pattern ] ] ;
    ] ;
    sh:property [
        sh:path spp:monitoringPlatform ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:monitoring-platform ] ] ;
    ] ;
    sh:property [
        sh:path spp:observabilityPractice ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:observability-practice ] ] ;
    ] ;
    sh:property [
        sh:path spp:testMethodology ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:test-methodology ] ] ;
    ] ;
    sh:property [
        sh:path spp:testCategory ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:test-category ] ] ;
    ] ;
    sh:property [
        sh:path spp:testTechnique ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:test-technique ] ] ;
    ] ;
    sh:property [
        sh:path spp:securityTestingPractice ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:security-testing-practice ] ] ;
    ] ;
    sh:property [
        sh:path spp:securityModel ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:security-model ] ] ;
        sh:severity sh:Warning ;
        sh:message "Security model is Tier-1; declare it explicitly (Zero Trust, least-privilege, etc.)."@en ;
    ] ;
    sh:property [
        sh:path spp:supplyChainSecurityPractice ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:supply-chain-security-practice ] ] ;
    ] ;
    sh:property [
        sh:path spp:privacyCompliancePractice ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:privacy-compliance-practice ] ] ;
    ] ;
    sh:property [
        sh:path spp:processMethodology ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:process-methodology ] ] ;
    ] ;
    sh:property [
        sh:path spp:engineeringPractice ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:engineering-practice ] ] ;
    ] ;
    sh:property [
        sh:path spp:complianceLevel ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:compliance-level ] ] ;
    ] ;
    sh:property [
        sh:path spp:documentationApproach ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:documentation-approach ] ] ;
    ] ;
    sh:property [
        sh:path spp:aiMlPosture ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:ai-ml-posture ] ] ;
    ] ;
    sh:property [
        sh:path spp:finOpsPosture ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:finops-posture ] ] ;
    ] ;
    sh:property [
        sh:path spp:dataStreamingPattern ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:data-streaming-pattern ] ] ;
    ] ;
    sh:property [
        sh:path spp:messagingPlatform ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:messaging-platform ] ] ;
    ] ;
    sh:property [
        sh:path spp:qualityCharacteristic ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:quality-characteristic ] ] ;
    ] ;
    sh:property [
        sh:path spp:operationalExcellenceArea ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:operational-excellence-area ] ] ;
    ] ;
    sh:property [
        sh:path spp:maintenanceType ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:maintenance-type ] ] ;
    ] ;
    # --- SEMAT Alpha state properties ---
    sh:property [
        sh:path spp:stakeholderAlphaState ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:stakeholder-alpha-state ] ] ;
    ] ;
    sh:property [
        sh:path spp:opportunityAlphaState ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:opportunity-alpha-state ] ] ;
    ] ;
    sh:property [
        sh:path spp:requirementsAlphaState ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:requirements-alpha-state ] ] ;
    ] ;
    sh:property [
        sh:path spp:softwareSystemAlphaState ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:software-system-alpha-state ] ] ;
    ] ;
    sh:property [
        sh:path spp:teamAlphaState ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:team-alpha-state ] ] ;
    ] ;
    sh:property [
        sh:path spp:wayOfWorkingAlphaState ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:way-of-working-alpha-state ] ] ;
    ] ;
    sh:property [
        sh:path spp:workAlphaState ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:work-alpha-state ] ] ;
    ] .

# --- 11.1.c PlannedEnvironment shape ---
sppsh:PlannedEnvironmentShape a sh:NodeShape ;
    sh:targetClass spp:PlannedEnvironment ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment
                           dct:title dct:description dct:conformsTo
                           dct:identifier ) ;
    sh:property [
        sh:path spp:environmentName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A planned environment must have exactly one environmentName."@en ;
    ] ;
    sh:property [
        sh:path spp:plannedEnvironmentKind ;
        sh:class skos:Concept ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:planned-environment-kind ] ] ;
        sh:message "Every planned environment must declare its kind."@en ;
    ] ;
    sh:property [
        sh:path spp:isActive ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "isActive is a runtime fact; it does not belong in a plan."@en ;
    ] .

# --- 11.1.d PlannedLink shape ---
sppsh:PlannedLinkShape a sh:NodeShape ;
    sh:targetClass spp:PlannedLink ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment
                           dct:title dct:description dct:conformsTo
                           dct:identifier ) ;
    sh:property [
        sh:path spp:linkSource ;
        sh:class spp:Component ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A planned link must declare exactly one source component."@en ;
    ] ;
    sh:property [
        sh:path spp:linkTarget ;
        sh:class spp:Component ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A planned link must declare exactly one target component."@en ;
    ] ;
    sh:property [
        sh:path spp:plannedLinkRelation ;
        sh:class skos:Concept ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:planned-link-relation ] ] ;
    ] ;
    sh:property [
        sh:path spp:runtimeRelation ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:runtime-relation ] ] ;
    ] ;
    sh:property [
        sh:path spp:dataRelationCardinality ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:data-relation-cardinality ] ] ;
    ] .

# --- 11.1.f Extended ArchitecturalDecision shape — adds status, target, consequences ---
sppsh:ArchitecturalDecisionExtendedShape a sh:NodeShape ;
    sh:targetClass spp:ArchitecturalDecision ;
    sh:property [
        sh:path spp:decisionStatus ;
        sh:class skos:Concept ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:architectural-decision-status ] ] ;
        sh:message "Every ADR must have exactly one lifecycle status (proposed / accepted / rejected / deprecated / superseded / challenged)."@en ;
    ] ;
    sh:property [
        sh:path spp:decisionTargetKind ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:decision-target-kind ] ] ;
    ] ;
    sh:property [
        sh:path spp:decisionConsequenceKind ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:decision-consequence-kind ] ] ;
    ] .

# --- 11.2 Component shape (closed; excludes runtime fields) ---

sppsh:ComponentShape a sh:NodeShape ;
    sh:targetClass spp:Component ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment
                           dct:title dct:description dct:conformsTo
                           dct:identifier ) ;
    sh:property [
        sh:path spp:componentName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A component must have exactly one componentName."@en ;
    ] ;
    sh:property [
        sh:path spp:declaredDependency ;
        sh:class spp:Dependency ;
    ] ;
    sh:property [
        sh:path spp:moduleRole ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:module-role ] ] ;
    ] ;
    sh:property [
        sh:path spp:componentOwnership ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:component-ownership ] ] ;
    ] ;
    # Explicit anti-runtime guards:
    sh:property [
        sh:path spp:currentVersion ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "currentVersion is a runtime fact; it does not belong in a plan."@en ;
    ] ;
    sh:property [
        sh:path spp:archivedAt ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "archivedAt is a runtime fact; it does not belong in a plan."@en ;
    ] .

# --- 11.3 Dependency shape (excludes resolved_version) ---

sppsh:DependencyShape a sh:NodeShape ;
    sh:targetClass spp:Dependency ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment
                           dct:title dct:description dct:conformsTo
                           dct:identifier ) ;
    sh:property [
        sh:path spp:dependencyName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A dependency must have exactly one dependencyName."@en ;
    ] ;
    sh:property [
        sh:path spp:dependencyKind ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:dependency-kind ] ] ;
        sh:severity sh:Warning ;
        sh:message "Every declared dependency should specify its kind."@en ;
    ] ;
    sh:property [
        sh:path spp:resolvedVersion ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "resolvedVersion is computed by a resolver at build time, not declared in a plan."@en ;
    ] .

# --- 11.4 Architectural decision shape ---

sppsh:ArchitecturalDecisionShape a sh:NodeShape ;
    sh:targetClass spp:ArchitecturalDecision ;
    sh:property [
        sh:path spp:decisionKind ;
        sh:class skos:Concept ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:decision-kind ] ] ;
        sh:message "Every architectural decision must be classified by Kruchten kind (existence / property / executive / ban)."@en ;
    ] ;
    sh:property [
        sh:path spp:decisionForce ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:decision-force ] ] ;
    ] ;
    sh:property [
        sh:path spp:reversibilityClass ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:reversibility-tier ] ] ;
    ] ;
    sh:property [
        sh:path spp:technicalDebtType ;
        sh:class skos:Concept ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue sppc:technical-debt-type ] ] ;
    ] .

# --- 11.5 Reusable "in concept scheme" sub-shapes ---

# --- Sub-shapes added in v4.1 for the exhaustive scheme set ---
# --- 11.6 Concept-scheme metadata invariants ---
# Every concept scheme in this ontology must declare axis, tier, status,
# and at least one grounding source. The shape below enforces this.

sppsh:ConceptSchemeMetadataShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX spp:  <https://software-project-plan.org/v4/ontology#>
            PREFIX sppst: <https://software-project-plan.org/v4/status#>
            SELECT ?this WHERE {
                ?this rdf:type skos:ConceptScheme .
                # Primary exemption (v4.1.0): framework-internal nodes
                # declare their status explicitly. New framework-internal
                # classes (e.g. a future spp:Lens) need only carry
                # spp:groundingStatus sppst:FRAMEWORK_INTERNAL to be
                # exempted; no SPARQL change required.
                FILTER NOT EXISTS { ?this spp:groundingStatus sppst:FRAMEWORK_INTERNAL . }
                # Legacy exemptions (kept as defence-in-depth for any
                # framework-internal node that has not yet been
                # annotated with the FRAMEWORK_INTERNAL status):
                FILTER NOT EXISTS { ?this rdf:type spp:MetaScheme . }
                FILTER NOT EXISTS { ?this rdf:type spp:Axis . }
            }
        """ ;
    ] ;
    rdfs:comment """Applies to all project-decision concept schemes;
        framework-internal nodes (meta-schemes, axes, future internal
        classes) are exempted.

        v4.1.0: primary exemption signal is spp:groundingStatus
        sppst:FRAMEWORK_INTERNAL, declared by the node itself. The
        class-based exemptions (NOT EXISTS for spp:MetaScheme /
        spp:Axis) are retained as defence-in-depth so that a partially
        annotated graph still validates correctly. Future
        framework-internal classes should be annotated rather than
        added to the SPARQL filter."""@en ;
    sh:property [
        sh:path spp:axisPosition ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Every scheme should declare an axisPosition."@en ;
    ] ;
    sh:property [
        sh:path spp:tier ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Every scheme should declare a reversibility tier."@en ;
    ] ;
    sh:property [
        sh:path spp:groundingStatus ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Every scheme should declare a grounding status."@en ;
    ] ;
    sh:property [
        sh:path spp:groundedIn ;
        sh:severity sh:Info ;
        sh:message "Schemes with grounding status PRACTITIONER_ONLY may have zero formal sources; FORMALLY/PARTIALLY_GROUNDED schemes should cite at least one."@en ;
    ] .

# --- 11.7 Cross-shape semantic rule: a plan with public visibility
#         MUST declare a privacy posture and an SBOM policy ---

sppsh:PublicallyReadablePlanRequiresPrivacyAndSbomShape a sh:NodeShape ;
    # v4.1.0 (P1 #4): widened target from vis-public ONLY to
    # vis-public OR vis-open-source. Open-source repositories are
    # publicly readable by anyone who can read GitHub/GitLab/etc.;
    # the privacy + SBOM declaration matters at least as much as
    # for closed-source public plans. Distinguishing them at the
    # rule level was a category error.
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX spp:  <https://software-project-plan.org/v4/ontology#>
            PREFIX sppc: <https://software-project-plan.org/v4/concept/>
            SELECT ?this WHERE {
                ?this rdf:type spp:SoftwareProjectPlan .
                ?this spp:visibility ?vis .
                FILTER (?vis IN (sppc:vis-public, sppc:vis-open-source))
            }
        """ ;
    ] ;
    sh:property [
        sh:path spp:privacyPosture ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A plan with public or open-source visibility MUST declare privacyPosture."@en ;
    ] ;
    sh:property [
        sh:path spp:sbomPolicy ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A plan with public or open-source visibility MUST declare sbomPolicy."@en ;
    ] .

# Backward-compatibility alias: the old IRI for this shape continues
# to resolve to the new one via owl:sameAs, so any external SHACL
# graph that imported the v4.0.0 shape by name keeps working.
sppsh:PublicPlanRequiresPrivacyAndSbomShape
    owl:sameAs sppsh:PublicallyReadablePlanRequiresPrivacyAndSbomShape .

# =============================================================================
# 12. ABSTRACTION-BOUNDARY OWL DISJOINTNESS
# =============================================================================
# The runtime properties listed above are declared owl:DatatypeProperty in
# §10 only so that we can reference them. Here we make their incompatibility
# with the plan explicit at the OWL level too (in addition to the SHACL
# anti-runtime guards in §11.2 and §11.3).

spp:currentVersion owl:propertyDisjointWith spp:planVersion .
