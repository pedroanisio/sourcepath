# --- 8.10 ISO 14764:2022 Maintenance Type ---
sppc:maintenance-type a skos:ConceptScheme ;
    dct:title "Software Maintenance Type"@en ;
    rdfs:comment "Four-category core per ISO/IEC/IEEE 14764:2022. Emergency is a recognised urgency-variant of corrective per Lientz & Swanson tradition, NOT a peer category in the standard."@en ;
    spp:axisPosition spp:axisPhase ;
    spp:tier sppt:T2 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:iso14764-2022 ;
    skos:hasTopConcept sppc:maint-adaptive ,
        sppc:maint-corrective ,
        sppc:maint-emergency ,
        sppc:maint-perfective ,
        sppc:maint-preventive .

sppc:maint-corrective  a skos:Concept ; skos:inScheme sppc:maintenance-type ; skos:prefLabel "Corrective"@en .
sppc:maint-adaptive    a skos:Concept ; skos:inScheme sppc:maintenance-type ; skos:prefLabel "Adaptive"@en .
sppc:maint-perfective  a skos:Concept ; skos:inScheme sppc:maintenance-type ; skos:prefLabel "Perfective"@en .
sppc:maint-preventive  a skos:Concept ; skos:inScheme sppc:maintenance-type ; skos:prefLabel "Preventive"@en .
sppc:maint-emergency   a skos:Concept ; skos:inScheme sppc:maintenance-type ; skos:prefLabel "Emergency (urgent variant of corrective)"@en ;
    skos:broader sppc:maint-corrective .

# --- 8.11 System-of-Systems Type (Maier/Dahmann/ISO 21839) ---
sppc:system-of-systems-type a skos:ConceptScheme ;
    dct:title "System-of-Systems Type"@en ;
    rdfs:comment "Maier 1998 (3 types) + Dahmann 2008 (added Acknowledged); ratified in ISO/IEC/IEEE 21839:2019."@en ;
    spp:axisPosition spp:axisScope ;
    spp:tier sppt:T1 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:maier-1998 , sppsrc:dahmann-2008 , sppsrc:iso21839-2019 ;
    skos:hasTopConcept sppc:sos-acknowledged ,
        sppc:sos-collaborative ,
        sppc:sos-directed ,
        sppc:sos-virtual .

sppc:sos-directed     a skos:Concept ; skos:inScheme sppc:system-of-systems-type ; skos:prefLabel "Directed"@en .
sppc:sos-acknowledged a skos:Concept ; skos:inScheme sppc:system-of-systems-type ; skos:prefLabel "Acknowledged"@en .
sppc:sos-collaborative a skos:Concept ; skos:inScheme sppc:system-of-systems-type ; skos:prefLabel "Collaborative"@en .
sppc:sos-virtual      a skos:Concept ; skos:inScheme sppc:system-of-systems-type ; skos:prefLabel "Virtual"@en .

