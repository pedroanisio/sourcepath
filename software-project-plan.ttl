sppc:dsp-log-aggregation a skos:Concept ; skos:inScheme sppc:data-streaming-pattern ; skos:prefLabel "Log aggregation"@en .
sppc:dsp-stream-proc     a skos:Concept ; skos:inScheme sppc:data-streaming-pattern ; skos:prefLabel "Stream processing"@en .
sppc:dsp-lambda-arch     a skos:Concept ; skos:inScheme sppc:data-streaming-pattern ; skos:prefLabel "Lambda architecture"@en .
sppc:dsp-kappa-arch      a skos:Concept ; skos:inScheme sppc:data-streaming-pattern ; skos:prefLabel "Kappa architecture"@en .

# --- 8.57 MessagingPlatform (T2) ---
sppc:messaging-platform a skos:ConceptScheme ;
    dct:title "Messaging Platform"@en ;
    rdfs:comment "AMQP is the T1 wire protocol for RabbitMQ; Kafka has its own protocol (T2 vendor)."@en ;
    spp:axisPosition spp:axisConcern ;
    spp:tier sppt:T2 ;
    spp:groundingStatus sppst:PARTIALLY_GROUNDED ;
    spp:groundedIn sppsrc:amqp-0-9-1 , sppsrc:apache-kafka ;
    skos:hasTopConcept sppc:mp-eventbridge ,
        sppc:mp-kafka ,
        sppc:mp-nats ,
        sppc:mp-pubsub ,
        sppc:mp-pulsar ,
        sppc:mp-rabbitmq ,
        sppc:mp-redis-streams ,
        sppc:mp-service-bus ,
        sppc:mp-sns ,
        sppc:mp-sqs .

sppc:mp-kafka          a skos:Concept ; skos:inScheme sppc:messaging-platform ; skos:prefLabel "Apache Kafka"@en .
sppc:mp-rabbitmq       a skos:Concept ; skos:inScheme sppc:messaging-platform ; skos:prefLabel "RabbitMQ (AMQP)"@en .
sppc:mp-nats           a skos:Concept ; skos:inScheme sppc:messaging-platform ; skos:prefLabel "NATS"@en .
sppc:mp-pulsar         a skos:Concept ; skos:inScheme sppc:messaging-platform ; skos:prefLabel "Apache Pulsar"@en .
sppc:mp-sqs            a skos:Concept ; skos:inScheme sppc:messaging-platform ; skos:prefLabel "AWS SQS"@en .
sppc:mp-sns            a skos:Concept ; skos:inScheme sppc:messaging-platform ; skos:prefLabel "AWS SNS"@en .
sppc:mp-eventbridge    a skos:Concept ; skos:inScheme sppc:messaging-platform ; skos:prefLabel "AWS EventBridge"@en .
sppc:mp-service-bus    a skos:Concept ; skos:inScheme sppc:messaging-platform ; skos:prefLabel "Azure Service Bus"@en .
sppc:mp-pubsub         a skos:Concept ; skos:inScheme sppc:messaging-platform ; skos:prefLabel "Google Cloud Pub/Sub"@en .
sppc:mp-redis-streams  a skos:Concept ; skos:inScheme sppc:messaging-platform ; skos:prefLabel "Redis Streams"@en .

# =============================================================================
# ADR meta-vocabulary (8.58 – 8.61)
# =============================================================================

# --- 8.58 ArchitecturalDecisionStatus (META) ---
sppc:architectural-decision-status a skos:ConceptScheme , spp:MetaScheme ;
    dct:title "Architectural Decision Status"@en ;
    rdfs:comment "ADR lifecycle states. Combines Kruchten 2004 decision lifecycle + Nygard 2011 ADR template."@en ;
    spp:groundedIn sppsrc:kruchten-2004 , sppsrc:nygard-adr , sppsrc:iso42010-2022 ;
    skos:hasTopConcept sppc:ads-accepted ,
        sppc:ads-challenged ,
        sppc:ads-deprecated ,
        sppc:ads-proposed ,
        sppc:ads-rejected ,
        sppc:ads-superseded .

sppc:ads-proposed   a skos:Concept ; skos:inScheme sppc:architectural-decision-status ; skos:prefLabel "Proposed"@en .
sppc:ads-accepted   a skos:Concept ; skos:inScheme sppc:architectural-decision-status ; skos:prefLabel "Accepted"@en .
sppc:ads-rejected   a skos:Concept ; skos:inScheme sppc:architectural-decision-status ; skos:prefLabel "Rejected"@en .
sppc:ads-deprecated a skos:Concept ; skos:inScheme sppc:architectural-decision-status ; skos:prefLabel "Deprecated"@en .
sppc:ads-superseded a skos:Concept ; skos:inScheme sppc:architectural-decision-status ; skos:prefLabel "Superseded"@en .
sppc:ads-challenged a skos:Concept ; skos:inScheme sppc:architectural-decision-status ; skos:prefLabel "Challenged"@en .

# --- 8.59 DecisionOptionStatus (META, Tyree & Akerman 2005) ---
# Reserved vocabulary. No SHACL property shape currently references
# this scheme; a future spp:DecisionOption sub-entity (alternatives
# considered alongside the selected option, per van Heesch 2012's
# "Forces" viewpoint and Tyree & Akerman 2005's option-status field)
# will plug into it. The vocabulary is kept in place rather than
# inlined or removed so that the eventual extension is purely
# additive and does not require a vocabulary migration.
sppc:decision-option-status a skos:ConceptScheme , spp:MetaScheme ;
    dct:title "Decision Option Status"@en ;
    spp:groundedIn sppsrc:tyree-akerman-2005 ;
    skos:hasTopConcept sppc:dos-considered ,
        sppc:dos-proposed ,
        sppc:dos-rejected ,
        sppc:dos-selected .

sppc:dos-proposed   a skos:Concept ; skos:inScheme sppc:decision-option-status ; skos:prefLabel "Proposed"@en .
sppc:dos-considered a skos:Concept ; skos:inScheme sppc:decision-option-status ; skos:prefLabel "Considered"@en .
sppc:dos-selected   a skos:Concept ; skos:inScheme sppc:decision-option-status ; skos:prefLabel "Selected"@en .
sppc:dos-rejected   a skos:Concept ; skos:inScheme sppc:decision-option-status ; skos:prefLabel "Rejected"@en .

# --- 8.60 DecisionTargetKind (META, Kruchten 2004 informed) ---
sppc:decision-target-kind a skos:ConceptScheme , spp:MetaScheme ;
    dct:title "Decision Target Kind"@en ;
    rdfs:comment "What the decision binds. Inspired by Kruchten existence/property/executive scope levels."@en ;
    spp:groundedIn sppsrc:kruchten-2004 , sppsrc:iso42010-2022 ;
    skos:hasTopConcept sppc:dtk-class ,
        sppc:dtk-component ,
        sppc:dtk-data-model ,
        sppc:dtk-deployment ,
        sppc:dtk-infrastructure ,
        sppc:dtk-interface ,
        sppc:dtk-module ,
        sppc:dtk-process ,
        sppc:dtk-protocol ,
        sppc:dtk-subsystem ,
        sppc:dtk-system .

sppc:dtk-system         a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "System"@en .
sppc:dtk-subsystem      a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "Subsystem"@en .
sppc:dtk-component      a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "Component"@en .
sppc:dtk-module         a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "Module / package"@en .
sppc:dtk-class          a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "Class / type"@en .
sppc:dtk-interface      a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "Interface / API"@en .
sppc:dtk-protocol       a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "Protocol / wire format"@en .
sppc:dtk-data-model     a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "Data model"@en .
sppc:dtk-process        a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "Process / methodology"@en .
sppc:dtk-deployment     a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "Deployment unit"@en .
sppc:dtk-infrastructure a skos:Concept ; skos:inScheme sppc:decision-target-kind ; skos:prefLabel "Infrastructure"@en .

# --- 8.61 DecisionConsequenceKind (META, Kruchten 2004 + ATAM) ---
sppc:decision-consequence-kind a skos:ConceptScheme , spp:MetaScheme ;
    dct:title "Decision Consequence Kind"@en ;
    rdfs:comment "What is affected by the decision (the trade-offs). Aligns with ATAM (Kazman 2000) sensitivity points + ISO 25010 characteristics."@en ;
    spp:groundedIn sppsrc:kruchten-2004 , sppsrc:atam , sppsrc:iso25010-2023 ;
    skos:hasTopConcept sppc:dck-availability ,
        sppc:dck-cost ,
        sppc:dck-latency ,
        sppc:dck-maintainability ,
        sppc:dck-op-complexity ,
        sppc:dck-performance ,
        sppc:dck-privacy ,
        sppc:dck-safety ,
        sppc:dck-scalability ,
        sppc:dck-security ,
        sppc:dck-throughput ,
        sppc:dck-vendor-lockin .

sppc:dck-performance    a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Performance"@en .
sppc:dck-security       a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Security"@en .
sppc:dck-cost           a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Cost"@en .
sppc:dck-maintainability a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Maintainability"@en .
sppc:dck-scalability    a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Scalability"@en .
sppc:dck-availability   a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Availability"@en .
sppc:dck-latency        a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Latency"@en .
sppc:dck-throughput     a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Throughput"@en .
sppc:dck-op-complexity  a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Operational complexity"@en .
sppc:dck-vendor-lockin  a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Vendor lock-in"@en .
sppc:dck-privacy        a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Privacy"@en .
sppc:dck-safety         a skos:Concept ; skos:inScheme sppc:decision-consequence-kind ; skos:prefLabel "Safety"@en .

