# =============================================================================
# software-project-plan.ttl
# A SHACL/TTL ontology + shapes for software-project plans.
# Version: 4.0.0  (TTL re-grounding of project_schema.yaml v2.2.0 +
#                  project.ts v3.0.4 + all research findings)
# Format: Turtle 1.1 (W3C Recommendation, 2014)
# Validates:
#   - As an OWL 2 ontology (Manchester/RDF/XML serialisations also valid)
#   - As a SHACL shapes graph (W3C SHACL, 2017)
#   - Against any RDF data graph claiming dct:conformsTo this ontology
# =============================================================================
#
# DESIGN CHOICES (load-bearing):
#
#   1. ABSTRACTION BOUNDARY. The schema models the PLAN — declarations made
#      at or before authoring. Runtime properties (current_version,
#      archived_at, resolved_version, is_active) are not part of this
#      ontology and are explicitly excluded by sh:closed shapes on the
#      top-level entity. A sibling ontology (out of scope) would model the
#      realised view.
#
#   2. FOUR ORTHOGONAL AXES. Every categorical vocabulary in this ontology
#      is positioned in a four-axis space: Concern × Phase × Scope ×
#      Externality. The axes follow the structure documented in the
#      reversibility-tiers article and are individually grounded:
#        - Concern   : ISO/IEC 25010:2023 (9 chars) + AWS WAF (6 pillars)
#        - Phase     : ISO/IEC/IEEE 12207:2017 + ISO/IEC/IEEE 15288:2015
#        - Scope     : ISO/IEC/IEEE 42010:2022 + Kruchten 4+1
#        - Externality: weakly grounded; supported by Tofan/van Heesch/
#                       Alves/Bezos. Acknowledged as the weakest axis.
#
#   3. REVERSIBILITY TIERS. Each categorical vocabulary carries a
#      spp:tier annotation (T0 Foundational → T3 Tactical) consistent
#      with the tier classification deliverable and the article model.
#
#   4. PROVENANCE FIRST. Every concept scheme links to its grounding
#      sources via dct:source and spp:groundedIn. Sources are typed
#      (prov:Entity) and tiered (T1 ISO/IEEE/RFC normative → T4
#      practitioner literature).
#
#   5. ENUMS ARE SKOS CONCEPT SCHEMES, NOT OWL CLASSES. This permits
#      multilingual labels, alternative labels, and revision over time
#      without breaking validators. SHACL shapes use sh:in or
#      "skos:inScheme = <scheme>" patterns to constrain valid values.
#
#   6. STATUS VERDICTS. Each scheme carries one of
#      FORMALLY_GROUNDED / PARTIALLY_GROUNDED / PRACTITIONER_ONLY,
#      auditable by the assertion pipeline.
#
# DISCLAIMER (per user preference). No information in this document
# should be taken for granted. Any statement or premise not backed by a
# real logical definition or verifiable reference may be invalid,
# erroneous, or a hallucination. The cited standards (ISO 25010:2023,
# 12207:2017, 14764:2022, 15288:2015, 42010:2022, AWS WAF, etc.) have
# been verified against primary catalogues, but exact section numbers
# and clause boundaries should be re-verified against the standards
# themselves before formal use. The tier and axis assignments reflect
# the schema authors' synthesis, not consensus standards.
# =============================================================================

# -----------------------------------------------------------------------------
# Prefixes
# -----------------------------------------------------------------------------
@prefix spp:    <https://software-project-plan.org/v4/ontology#> .
@prefix sppe:   <https://software-project-plan.org/v4/entity#> .
@prefix sppc:   <https://software-project-plan.org/v4/concept/> .
@prefix sppa:   <https://software-project-plan.org/v4/axis#> .
@prefix sppt:   <https://software-project-plan.org/v4/tier#> .
@prefix sppst:  <https://software-project-plan.org/v4/status#> .
@prefix sppsrc: <https://software-project-plan.org/v4/source#> .
@prefix sppsh:  <https://software-project-plan.org/v4/shape#> .

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .

# =============================================================================
# 1. ONTOLOGY METADATA
# =============================================================================

<https://software-project-plan.org/v4>
    a owl:Ontology ;
    owl:versionIRI <https://software-project-plan.org/v4.1.0> ;
    owl:versionInfo "4.1.0" ;
    dct:title "Software Project Plan Ontology"@en ;
    dct:description """A SHACL/TTL ontology describing the categorical
        decisions that constitute a software project plan, grounded in
        ISO 25010:2023, ISO/IEC/IEEE 12207:2017, ISO/IEC/IEEE 14764:2022,
        ISO/IEC/IEEE 15288:2015, ISO/IEC/IEEE 42010:2022, AWS
        Well-Architected, OMG SEMAT Essence kernel, Kruchten's ontology
        of architectural design decisions (2004), van Heesch et al.'s
        forces viewpoint (2012), and Alves et al.'s technical-debt
        taxonomy (2016). Each decision category is positioned in a
        four-axis space (Concern × Phase × Scope × Externality) and
        tagged with a reversibility tier (T0 Foundational → T3
        Tactical)."""@en ;
    dct:creator "Software-Project-Plan working group"@en ;
    dct:issued "2026-05-15"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:conformsTo <https://www.w3.org/TR/shacl/> ;
    dct:conformsTo <https://www.w3.org/TR/owl2-overview/> ;
    vann:preferredNamespacePrefix "spp" ;
    vann:preferredNamespaceUri "https://software-project-plan.org/v4/ontology#" ;
    rdfs:comment """Disclaimer: Nothing in this ontology should be
        taken for granted. Any statement or premise not backed by a
        verifiable reference may be invalid, erroneous, or a
        hallucination. Tier and axis assignments are a structured
        synthesis, not consensus standards.

        VALIDATION CONTRACT (added in v4.1.0):
        Consumers MUST run SHACL validation with RDFS expansion
        DISABLED. The SHACL shapes in §11 are self-sufficient: each
        carries an explicit sh:targetClass and the closed shapes carry
        sh:ignoredProperties for legitimate Dublin Core metadata.

        Running pyshacl (or any SHACL engine) with inference='rdfs' on
        this graph plus an instance graph will produce spurious
        violations because:
          (a) rdfs:domain spp:SoftwareProjectPlan on planName /
              planVersion / spp:component / spp:decision causes any
              sub-entity that mistakenly carries one of those
              properties to be inferred as a SoftwareProjectPlan and
              cascade-fail the closed-shape constraint with dozens of
              missing-property violations;
          (b) rdfs:domain spp:Categorical on spp:groundedIn (now
              removed in v4.1.0) used to similarly promote framework
              internal nodes (axes, meta-schemes) into ConceptSchemes.
        The OWL-side domain declarations are kept for documentation
        and reasoner audits (\"where is this property legal?\"), not
        as runtime constraints. The SHACL closed shapes are the
        runtime constraint surface."""@en .

# =============================================================================
# 2. AXES — the four-dimensional space of design decisions
# =============================================================================

spp:Axis a owl:Class ;
    rdfs:label "Axis"@en ;
    rdfs:comment "A dimension along which categorical design decisions vary."@en .

spp:axisConcern a spp:Axis ;
    rdfs:label "Concern axis"@en ;
    rdfs:comment "What aspect of the system the decision affects."@en ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL ;
    spp:groundedIn sppsrc:iso25010-2023 , sppsrc:aws-waf .

spp:axisPhase a spp:Axis ;
    rdfs:label "Phase axis"@en ;
    rdfs:comment "When in the lifecycle the decision binds."@en ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL ;
    spp:groundedIn sppsrc:iso12207-2017 , sppsrc:iso15288-2015 .

spp:axisScope a spp:Axis ;
    rdfs:label "Scope axis"@en ;
    rdfs:comment "What part of the system the decision binds."@en ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL ;
    spp:groundedIn sppsrc:iso42010-2022 , sppsrc:kruchten-1995-4plus1 .

spp:axisExternality a spp:Axis ;
    rdfs:label "Externality axis"@en ;
    rdfs:comment """Who depends on the decision (and therefore how
        reversible it is). Weakly grounded relative to the other three;
        rests on Tofan 2014, van Heesch 2012, Alves 2016, and the Bezos
        2015/2016 shareholder letters."""@en ;
    spp:groundingQuality "weak"^^xsd:string ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL ;
    spp:groundedIn sppsrc:bezos-2015 , sppsrc:tofan-2014 ,
                   sppsrc:vanheesch-2012 .

# =============================================================================
# 3. REVERSIBILITY TIERS — T0 (Foundational) ... T3 (Tactical)
# =============================================================================

sppc:reversibility-tier a skos:ConceptScheme , spp:MetaScheme ;
    dct:title "Reversibility Tier"@en ;
    skos:hasTopConcept sppt:T0 , sppt:T1 , sppt:T2 , sppt:T3 ;
    spp:axisPosition spp:axisExternality ;
    spp:groundingStatus sppst:PARTIALLY_GROUNDED ;
    spp:groundedIn sppsrc:bezos-2015 ;
    rdfs:comment """A four-level refinement of Bezos's binary
        one-way/two-way door distinction. Each tier names the typical
        cost of reversing a decision."""@en .

sppt:T0 a skos:Concept ;
    skos:inScheme sppc:reversibility-tier ;
    skos:prefLabel "T0 — Foundational"@en ;
    skos:definition "Irreversible without a rewrite, a customer-breaking change, or a regulatory event."@en .

sppt:T1 a skos:Concept ;
    skos:inScheme sppc:reversibility-tier ;
    skos:prefLabel "T1 — Structural"@en ;
    skos:definition "Reversible only via a coordinated migration affecting external contracts or persisted data."@en .

sppt:T2 a skos:Concept ;
    skos:inScheme sppc:reversibility-tier ;
    skos:prefLabel "T2 — Architectural"@en ;
    skos:definition "Expensive internal refactor; customers unaffected."@en .

sppt:T3 a skos:Concept ;
    skos:inScheme sppc:reversibility-tier ;
    skos:prefLabel "T3 — Tactical"@en ;
    skos:definition "Localised, low blast radius; days of work or less."@en .

# =============================================================================
# 4. GROUNDING STATUS VERDICTS
# =============================================================================

spp:MetaScheme a owl:Class ;
    rdfs:subClassOf skos:ConceptScheme ;
    rdfs:label "Meta concept scheme"@en ;
    rdfs:comment """A concept scheme that describes the ontology's own
        vocabulary (e.g., reversibility tiers, grounding statuses, the
        Visibility scheme itself). Meta-schemes are exempt from the
        axisPosition / tier / groundedIn metadata invariant because
        they describe the framework, not project decisions."""@en .

sppc:grounding-status a skos:ConceptScheme , spp:MetaScheme ;
    dct:title "Grounding status"@en ;
    skos:hasTopConcept sppst:FORMALLY_GROUNDED ,
                       sppst:PARTIALLY_GROUNDED ,
                       sppst:PRACTITIONER_ONLY ,
                       sppst:UNGROUNDED ,
                       sppst:FRAMEWORK_INTERNAL .

sppst:FORMALLY_GROUNDED a skos:Concept ;
    skos:inScheme sppc:grounding-status ;
    skos:prefLabel "FORMALLY_GROUNDED"@en ;
    skos:definition "At least one Tier-1 or Tier-2 source directly grounds this category's existence."@en .

sppst:PARTIALLY_GROUNDED a skos:Concept ;
    skos:inScheme sppc:grounding-status ;
    skos:prefLabel "PARTIALLY_GROUNDED"@en ;
    skos:definition "Tier-2 or Tier-4 sources touch the concept but no Tier-1 standard endorses this exact partition."@en .

sppst:PRACTITIONER_ONLY a skos:Concept ;
    skos:inScheme sppc:grounding-status ;
    skos:prefLabel "PRACTITIONER_ONLY"@en ;
    skos:definition "Industry consensus only; no formal standard."@en .

sppst:UNGROUNDED a skos:Concept ;
    skos:inScheme sppc:grounding-status ;
    skos:prefLabel "UNGROUNDED"@en ;
    skos:definition "No source. A defect to remediate."@en .

sppst:FRAMEWORK_INTERNAL a skos:Concept ;
    skos:inScheme sppc:grounding-status ;
    skos:prefLabel "FRAMEWORK_INTERNAL"@en ;
    skos:definition """Introduced in v4.1.0 (P1 #9). Reserved for
        nodes that describe the framework itself (axes, meta-schemes,
        internal classification structures) rather than project-time
        decisions. Such nodes are inappropriate targets for the
        axisPosition / tier / groundedIn invariant — demanding that
        an axis declare its own axisPosition is circular. The
        ConceptSchemeMetadataShape's SPARQL target uses this verdict
        as the primary exemption signal, so future framework-internal
        classes can be exempted by annotation rather than by adding
        another `FILTER NOT EXISTS` clause."""@en .

# =============================================================================
# 5. GROUNDING SOURCES — verified during research (Part 1 of the report)
# =============================================================================

spp:GroundingSource a owl:Class ;
    rdfs:label "Grounding source"@en ;
    rdfs:subClassOf prov:Entity .

spp:SourceTier a owl:Class ;
    rdfs:label "Source authority tier"@en ;
    rdfs:comment """T1 = peer-reviewed paper or ISO/IEEE/IETF/OMG
        standard. T2 = official documentation or vendor architecture
        framework. T3 = verified industry dataset. T4 = high-quality
        expert article or book by recognised authority. T5 = community
        knowledge."""@en .

# --- Tier-1 standards ---

sppsrc:iso25010-2023 a spp:GroundingSource , prov:Entity ;
    spp:sourceTier "T1" ;
    dct:title "ISO/IEC 25010:2023 — SQuaRE Product Quality Model"@en ;
    dct:issued "2023-11"^^xsd:gYearMonth ;
    dct:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Edition 2 (Nov 2023); nine top-level characteristics: Functional Suitability, Performance Efficiency, Compatibility, Interaction Capability (renamed from Usability), Reliability, Security, Maintainability, Flexibility (renamed from Portability, with Scalability added), Safety (new)."@en .

