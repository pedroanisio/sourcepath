# --- 8.33 DataRelationCardinality (T1, UML) ---
sppc:data-relation-cardinality a skos:ConceptScheme ;
    dct:title "Data Relation Cardinality"@en ;
    rdfs:comment "UML association multiplicities. The 1:1 / 1:N / N:M tripartition is canonical and formally defined."@en ;
    spp:axisPosition spp:axisConcern ;
    spp:tier sppt:T1 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:groundedIn sppsrc:omg-uml , sppsrc:codd-1970 ;
    skos:hasTopConcept sppc:dc-many-to-many ,
        sppc:dc-one-to-many ,
        sppc:dc-one-to-one ,
        sppc:dc-zero-or-one ,
        sppc:dc-zero-to-many .

sppc:dc-one-to-one        a skos:Concept ; skos:inScheme sppc:data-relation-cardinality ; skos:prefLabel "1:1"@en .
sppc:dc-one-to-many       a skos:Concept ; skos:inScheme sppc:data-relation-cardinality ; skos:prefLabel "1:N"@en .
sppc:dc-many-to-many      a skos:Concept ; skos:inScheme sppc:data-relation-cardinality ; skos:prefLabel "N:M"@en .
sppc:dc-zero-or-one       a skos:Concept ; skos:inScheme sppc:data-relation-cardinality ; skos:prefLabel "0..1 (optional)"@en .
sppc:dc-zero-to-many      a skos:Concept ; skos:inScheme sppc:data-relation-cardinality ; skos:prefLabel "0..* (optional collection)"@en .

