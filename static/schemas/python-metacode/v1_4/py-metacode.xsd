<?xml version="1.0" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" xmlns:py="http://schemas.python.org/metacode/v1.4" targetNamespace="http://schemas.python.org/metacode/v1.4" elementFormDefault="qualified" attributeFormDefault="unqualified" vc:minVersion="1.1" version="1.4">
  <!-- ============================================== -->
  <!-- Root Elements                                  -->
  <!-- ============================================== -->
  <xs:element name="module" type="py:ModuleType"/>
  <xs:element name="project" type="py:ProjectType"/>
  <!-- ============================================== -->
  <!-- Foundational Simple Types                      -->
  <!-- ============================================== -->
  <xs:simpleType name="IdentifierType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_]*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ModulePathType">
    <xs:restriction base="xs:string">
      <xs:pattern value="([A-Za-z_][A-Za-z0-9_]*)(\.[A-Za-z_][A-Za-z0-9_]*)*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SemVerType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+\.\d+\.\d+([\-+][0-9A-Za-z\.\-]+)?"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PythonVersionType">
    <xs:restriction base="xs:string">
      <xs:pattern value="3\.(1[0-3]|[0-9])(\.\d+)?"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SeverityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="error"/>
      <xs:enumeration value="warning"/>
      <xs:enumeration value="info"/>
      <xs:enumeration value="hint"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DocstringFormatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="google"/>
      <xs:enumeration value="numpy"/>
      <xs:enumeration value="sphinx"/>
      <xs:enumeration value="epytext"/>
      <xs:enumeration value="plain"/>
    </xs:restriction>
  </xs:simpleType>
  <!-- ============================================== -->
  <!-- Module Definition                               -->
  <!-- ============================================== -->
  <xs:complexType name="ModuleType">
    <xs:sequence>
      <xs:element name="metadata" type="py:ModuleMetadataType" minOccurs="0"/>
      <xs:element name="docstring" type="py:DocstringType" minOccurs="0"/>
      <xs:element name="context" type="py:ContextType" minOccurs="0"/>
      <xs:element name="codeGen" type="py:CodeGenType" minOccurs="0"/>
      <xs:element name="imports" type="py:ImportsType" minOccurs="0"/>
      <xs:element name="moduleCode" type="py:ModuleCodeType" minOccurs="0"/>
      <xs:element name="typeAliases" type="py:TypeAliasesType" minOccurs="0"/>
      <xs:element name="constants" type="py:ConstantsType" minOccurs="0"/>
      <xs:element name="variables" type="py:VariablesType" minOccurs="0"/>
      <xs:element name="functions" type="py:FunctionsType" minOccurs="0"/>
      <xs:element name="classes" type="py:ClassesType" minOccurs="0"/>
      <xs:element name="protocols" type="py:ProtocolsType" minOccurs="0"/>
      <xs:element name="typedDicts" type="py:TypedDictsType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="py:IdentifierType" use="required"/>
    <xs:attribute name="package" type="py:ModulePathType"/>
    <xs:attribute name="version" type="py:SemVerType"/>
    <xs:attribute name="pythonVersion" type="py:PythonVersionType" default="3.13"/>
    <!-- Uniqueness constraints -->
    <xs:unique name="uniqueFunctionNames">
      <xs:selector xpath="py:functions/py:function"/>
      <xs:field xpath="@name"/>
    </xs:unique>
    <xs:unique name="uniqueClassNames">
      <xs:selector xpath="py:classes/py:class"/>
      <xs:field xpath="@name"/>
    </xs:unique>
  </xs:complexType>
  <xs:complexType name="ModuleMetadataType">
    <xs:sequence>
      <xs:element name="author" type="xs:string" minOccurs="0"/>
      <xs:element name="license" type="xs:string" minOccurs="0"/>
      <xs:element name="encoding" type="xs:string" minOccurs="0"/>
      <xs:element name="annotations" type="py:AnnotationsType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <!-- NEW in v1.4: Module-level execution code -->
  <xs:complexType name="ModuleCodeType">
    <xs:sequence>
      <xs:element name="block" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="statement" type="py:StatementType" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute name="order" type="xs:integer" use="required"/>
          <xs:attribute name="condition" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- NEW in v1.4: Docstring with format -->
  <xs:complexType name="DocstringType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="format" type="py:DocstringFormatType" default="plain"/>
        <xs:attribute name="raw" type="xs:boolean" default="false"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <!-- ============================================== -->
  <!-- Statement Types (NEW in v1.4)                  -->
  <!-- ============================================== -->
  <xs:complexType name="StatementType">
    <xs:choice>
      <xs:element name="assignment" type="py:AssignmentType"/>
      <xs:element name="expression" type="py:ValueType"/>
      <xs:element name="tryBlock" type="py:TryBlockType"/>
      <xs:element name="withBlock" type="py:WithBlockType"/>
      <xs:element name="ifBlock" type="py:IfBlockType"/>
      <xs:element name="forLoop" type="py:ForLoopType"/>
      <xs:element name="whileLoop" type="py:WhileLoopType"/>
      <xs:element name="return" type="py:ReturnType"/>
      <xs:element name="yield" type="py:YieldType"/>
      <xs:element name="raise" type="py:RaiseType"/>
      <xs:element name="assert" type="py:AssertType"/>
      <xs:element name="break" type="py:EmptyType"/>
      <xs:element name="continue" type="py:EmptyType"/>
      <xs:element name="pass" type="py:EmptyType"/>
      <xs:element name="delete" type="py:DeleteType"/>
      <xs:element name="global" type="py:GlobalType"/>
      <xs:element name="nonlocal" type="py:NonlocalType"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="BlockType">
    <xs:sequence>
      <xs:element name="statement" type="py:StatementType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="AssignmentType">
    <xs:sequence>
      <xs:element name="target" type="py:ValueType" maxOccurs="unbounded"/>
      <xs:element name="value" type="py:ValueType"/>
    </xs:sequence>
    <xs:attribute name="augmented" type="xs:string"/>
    <!-- +=, -=, etc. -->
  </xs:complexType>
  <!-- Exception Handling (NEW in v1.4) -->
  <xs:complexType name="TryBlockType">
    <xs:sequence>
      <xs:element name="try" type="py:BlockType"/>
      <xs:element name="except" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="exceptionType" type="py:TypeType" minOccurs="0"/>
            <xs:element name="as" type="py:IdentifierType" minOccurs="0"/>
            <xs:element name="body" type="py:BlockType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="else" type="py:BlockType" minOccurs="0"/>
      <xs:element name="finally" type="py:BlockType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <!-- Context Managers (NEW in v1.4) -->
  <xs:complexType name="WithBlockType">
    <xs:sequence>
      <xs:element name="contextManager" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="expression" type="py:ValueType"/>
            <xs:element name="as" type="py:IdentifierType" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="body" type="py:BlockType"/>
    </xs:sequence>
    <xs:attribute name="async" type="xs:boolean" default="false"/>
  </xs:complexType>
  <!-- Control Flow (NEW in v1.4) -->
  <xs:complexType name="IfBlockType">
    <xs:sequence>
      <xs:element name="condition" type="py:ValueType"/>
      <xs:element name="then" type="py:BlockType"/>
      <xs:element name="elif" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="condition" type="py:ValueType"/>
            <xs:element name="then" type="py:BlockType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="else" type="py:BlockType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ForLoopType">
    <xs:sequence>
      <xs:element name="target" type="py:ValueType"/>
      <xs:element name="iterable" type="py:ValueType"/>
      <xs:element name="body" type="py:BlockType"/>
      <xs:element name="else" type="py:BlockType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="async" type="xs:boolean" default="false"/>
  </xs:complexType>
  <xs:complexType name="WhileLoopType">
    <xs:sequence>
      <xs:element name="condition" type="py:ValueType"/>
      <xs:element name="body" type="py:BlockType"/>
      <xs:element name="else" type="py:BlockType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ReturnType">
    <xs:sequence>
      <xs:element name="value" type="py:ValueType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="YieldType">
    <xs:sequence>
      <xs:element name="value" type="py:ValueType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="from" type="xs:boolean" default="false"/>
  </xs:complexType>
  <xs:complexType name="RaiseType">
    <xs:sequence>
      <xs:element name="exception" type="py:ValueType" minOccurs="0"/>
      <xs:element name="from" type="py:ValueType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="AssertType">
    <xs:sequence>
      <xs:element name="test" type="py:ValueType"/>
      <xs:element name="message" type="py:ValueType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="DeleteType">
    <xs:sequence>
      <xs:element name="target" type="py:ValueType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="GlobalType">
    <xs:sequence>
      <xs:element name="name" type="py:IdentifierType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="NonlocalType">
    <xs:sequence>
      <xs:element name="name" type="py:IdentifierType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="EmptyType"/>
  <!-- ============================================== -->
  <!-- Context Type (Enhanced in v1.4)                -->
  <!-- ============================================== -->
  <xs:complexType name="ContextType">
    <xs:sequence>
      <!-- Local context: immediate scope -->
      <xs:element name="local" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="variables" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="variable" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:attribute name="name" type="xs:string" use="required"/>
                      <xs:attribute name="type" type="xs:string"/>
                      <xs:attribute name="source" type="xs:string"/>
                      <xs:attribute name="mutable" type="xs:boolean" default="true"/>
                      <xs:attribute name="scope" type="xs:string"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="dependencies" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="dependency" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:attribute name="type" type="xs:string" use="required"/>
                      <xs:attribute name="usage" type="xs:string"/>
                      <xs:attribute name="methods" type="xs:string"/>
                      <xs:attribute name="async" type="xs:boolean" default="false"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="siblings" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="sibling" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:attribute name="name" type="xs:string" use="required"/>
                      <xs:attribute name="relationship" type="xs:string"/>
                      <xs:attribute name="order" type="xs:integer"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="callers" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="caller" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:attribute name="qualifiedName" type="xs:string" use="required"/>
                      <xs:attribute name="contract" type="xs:string"/>
                      <xs:attribute name="frequency" type="xs:string"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="callees" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="callee" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:attribute name="qualifiedName" type="xs:string" use="required"/>
                      <xs:attribute name="purpose" type="xs:string"/>
                      <xs:attribute name="optional" type="xs:boolean" default="false"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- Global context: project-wide -->
      <xs:element name="global" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="domainModel" type="xs:string" minOccurs="0"/>
            <xs:element name="projectPatterns" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="pattern" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:simpleContent>
                        <xs:extension base="xs:string">
                          <xs:attribute name="name" type="xs:string" use="required"/>
                          <xs:attribute name="applies" type="xs:boolean" default="true"/>
                          <xs:attribute name="side" type="xs:string"/>
                        </xs:extension>
                      </xs:simpleContent>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="sharedTypes" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="type" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:attribute name="name" type="xs:string" use="required"/>
                      <xs:attribute name="module" type="xs:string"/>
                      <xs:attribute name="immutable" type="xs:boolean" default="false"/>
                      <xs:attribute name="validation" type="xs:string"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="conventions" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="convention" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:simpleContent>
                        <xs:extension base="xs:string">
                          <xs:attribute name="rule" type="xs:string" use="required"/>
                          <xs:attribute name="severity" type="py:SeverityType" default="error"/>
                        </xs:extension>
                      </xs:simpleContent>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="crossCuttingConcerns" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="concern" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:attribute name="aspect" type="xs:string" use="required"/>
                      <xs:attribute name="strategy" type="xs:string"/>
                      <xs:attribute name="config" type="xs:string"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- Performance hints (NEW in v1.4) -->
      <xs:element name="performance" type="py:PerformanceHintsType" minOccurs="0"/>
      <!-- Security annotations (NEW in v1.4) -->
      <xs:element name="security" type="py:SecurityAnnotationsType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <!-- Performance Hints (NEW in v1.4) -->
  <xs:complexType name="PerformanceHintsType">
    <xs:sequence>
      <xs:element name="complexity" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="time" type="xs:string"/>
          <xs:attribute name="space" type="xs:string"/>
          <xs:attribute name="description" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="cacheable" type="xs:boolean" minOccurs="0"/>
      <xs:element name="hotPath" type="xs:boolean" minOccurs="0"/>
      <xs:element name="memoryIntensive" type="xs:boolean" minOccurs="0"/>
      <xs:element name="cpuIntensive" type="xs:boolean" minOccurs="0"/>
      <xs:element name="ioIntensive" type="xs:boolean" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <!-- Security Annotations (NEW in v1.4) -->
  <xs:complexType name="SecurityAnnotationsType">
    <xs:sequence>
      <xs:element name="trustBoundary" type="xs:boolean" minOccurs="0"/>
      <xs:element name="sanitizes" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="type" type="xs:string" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="validates" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="type" type="xs:string" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="taintSources" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="source" type="xs:string" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="privileged" type="xs:boolean" minOccurs="0"/>
      <xs:element name="auditLog" type="xs:boolean" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <!-- ============================================== -->
  <!-- Code Generation Type (Enhanced v1.4)           -->
  <!-- ============================================== -->
  <xs:complexType name="CodeGenType">
    <xs:sequence>
      <xs:element name="systemPrompt" type="xs:string" minOccurs="0"/>
      <xs:element name="prompt" type="xs:string" minOccurs="0"/>
      <xs:element name="context" type="py:ContextType" minOccurs="0"/>
      <xs:element name="examples" type="py:CodeExamplesType" minOccurs="0"/>
      <xs:element name="testCases" type="py:TestCasesType" minOccurs="0"/>
      <xs:element name="constraints" type="py:ConstraintsType" minOccurs="0"/>
      <xs:element name="validation" type="py:ValidationSpecType" minOccurs="0"/>
      <xs:element name="modelConfig" type="py:CodeGenModelType" minOccurs="0"/>
      <xs:element name="strategy" type="py:StrategyType" minOccurs="0"/>
      <xs:element name="annotations" type="py:AnnotationsType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="enabled" type="xs:boolean" default="true"/>
    <xs:attribute name="scope" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="project"/>
          <xs:enumeration value="module"/>
          <xs:enumeration value="class"/>
          <xs:enumeration value="method"/>
          <xs:enumeration value="property"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="inherit" type="xs:boolean" default="true"/>
  </xs:complexType>
  <xs:complexType name="ConstraintsType">
    <xs:sequence>
      <xs:element name="constraint" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="validator" type="xs:string" minOccurs="0"/>
          </xs:sequence>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="level" use="required">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="must"/>
                <xs:enumeration value="should"/>
                <xs:enumeration value="may"/>
                <xs:enumeration value="could"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- Validation Specification (Enhanced in v1.4) -->
  <xs:complexType name="ValidationSpecType">
    <xs:sequence>
      <xs:element name="postconditions" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="condition" maxOccurs="unbounded">
              <xs:complexType>
                <xs:simpleContent>
                  <xs:extension base="xs:string">
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="type" use="required">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="invariant"/>
                          <xs:enumeration value="ensures"/>
                          <xs:enumeration value="maintains"/>
                          <xs:enumeration value="establishes"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="language" type="xs:string" default="natural"/>
                  </xs:extension>
                </xs:simpleContent>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="proofs" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="proof" maxOccurs="unbounded">
              <xs:complexType>
                <xs:choice>
                  <xs:element name="regex" type="py:RegexProofType"/>
                  <xs:element name="eval" type="py:EvalProofType"/>
                  <xs:element name="ast" type="py:ASTProofType"/>
                  <xs:element name="smt" type="py:SMTProofType"/>
                  <xs:element name="test" type="py:TestProofType"/>
                  <xs:element name="external" type="py:ExternalProofType"/>
                </xs:choice>
                <xs:attribute name="name" type="xs:string" use="required"/>
                <xs:attribute name="severity" type="py:SeverityType" default="error"/>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- Structured Proof Types (NEW in v1.4) -->
  <xs:complexType name="RegexProofType">
    <xs:sequence>
      <xs:element name="pattern" type="xs:string"/>
      <xs:element name="flags" type="xs:string" minOccurs="0"/>
      <xs:element name="target" type="xs:string" default="code"/>
    </xs:sequence>
    <xs:attribute name="mustMatch" type="xs:boolean" default="true"/>
  </xs:complexType>
  <xs:complexType name="EvalProofType">
    <xs:sequence>
      <xs:element name="expression" type="xs:string"/>
      <xs:element name="context" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="safe" type="xs:boolean" default="true"/>
  </xs:complexType>
  <xs:complexType name="ASTProofType">
    <xs:sequence>
      <xs:element name="nodeType" type="xs:string"/>
      <xs:element name="xpath" type="xs:string" minOccurs="0"/>
      <xs:element name="assertion" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="SMTProofType">
    <xs:sequence>
      <xs:element name="solver" type="xs:string" default="z3"/>
      <xs:element name="formula" type="xs:string"/>
      <xs:element name="timeout" type="xs:integer" default="5000"/>
    </xs:sequence>
