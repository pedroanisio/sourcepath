<?xml version='1.0' encoding='utf-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://schemas.iso.org/iec/5055/2021" xmlns:tns="https://schemas.iso.org/iec/5055/2021" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2021.1">
  <xs:annotation>
    <xs:documentation>ISO/IEC 5055-compliant schema for automated source code quality measurement</xs:documentation>
  </xs:annotation>
  <xs:simpleType name="AssessmentIDType">
    <xs:annotation>
      <xs:documentation>AssessmentID identifier pattern ASSESS-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="ASSESS-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ApplicationIDType">
    <xs:annotation>
      <xs:documentation>ApplicationID identifier pattern APP-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="APP-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ComponentIDType">
    <xs:annotation>
      <xs:documentation>ComponentID identifier pattern COMP-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="COMP-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ModuleIDType">
    <xs:annotation>
      <xs:documentation>ModuleID identifier pattern MOD-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="MOD-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ViolationIDType">
    <xs:annotation>
      <xs:documentation>ViolationID identifier pattern VIOL-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="VIOL-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RuleIDType">
    <xs:annotation>
      <xs:documentation>RuleID identifier pattern RULE-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="RULE-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PatternIDType">
    <xs:annotation>
      <xs:documentation>PatternID identifier pattern PTRN-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="PTRN-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="WeaknessIDType">
    <xs:annotation>
      <xs:documentation>WeaknessID identifier pattern CWE-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="CWE-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RemediationIDType">
    <xs:annotation>
      <xs:documentation>RemediationID identifier pattern REM-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="REM-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="BaselineIDType">
    <xs:annotation>
      <xs:documentation>BaselineID identifier pattern BASE-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="BASE-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TrendIDType">
    <xs:annotation>
      <xs:documentation>TrendID identifier pattern TREND-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="TREND-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ThresholdIDType">
    <xs:annotation>
      <xs:documentation>ThresholdID identifier pattern THRESH-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="THRESH-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ScanIDType">
    <xs:annotation>
      <xs:documentation>ScanID identifier pattern SCAN-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="SCAN-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TechnologyIDType">
    <xs:annotation>
      <xs:documentation>TechnologyID identifier pattern TECH-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="TECH-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ComplianceRateType">
    <xs:annotation>
      <xs:documentation>ComplianceRate percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CodeCoverageType">
    <xs:annotation>
      <xs:documentation>CodeCoverage percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RuleViolationRateType">
    <xs:annotation>
      <xs:documentation>RuleViolationRate percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RemediationProgressType">
    <xs:annotation>
      <xs:documentation>RemediationProgress percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="QualityImprovementType">
    <xs:annotation>
      <xs:documentation>QualityImprovement percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TechnicalDebtRatioType">
    <xs:annotation>
      <xs:documentation>TechnicalDebtRatio percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SecurityCoverageType">
    <xs:annotation>
      <xs:documentation>SecurityCoverage percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TestCoverageType">
    <xs:annotation>
      <xs:documentation>TestCoverage percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="QualityScoreType">
    <xs:annotation>
      <xs:documentation>Overall quality score</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.0" />
      <xs:maxInclusive value="100.0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SeverityScoreType">
    <xs:annotation>
      <xs:documentation>Violation severity score</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="1.0" />
      <xs:maxInclusive value="10.0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ComplexityIndexType">
    <xs:annotation>
      <xs:documentation>Cyclomatic complexity</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="1" />
      <xs:maxInclusive value="1000" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TechnicalDebtHoursType">
    <xs:annotation>
      <xs:documentation>Technical debt in hours</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RiskIndexType">
    <xs:annotation>
      <xs:documentation>Risk assessment index</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.0" />
      <xs:maxInclusive value="100.0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MaintainabilityIndexType">
    <xs:annotation>
      <xs:documentation>Maintainability index</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.0" />
      <xs:maxInclusive value="100.0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PropagationCostType">
    <xs:annotation>
      <xs:documentation>Change propagation cost</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.0" />
      <xs:maxInclusive value="1.0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CouplingLevelType">
    <xs:annotation>
      <xs:documentation>Coupling between components</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="GUIDType">
    <xs:annotation>
      <xs:documentation>UUID/GUID pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" />
      <xs:minLength value="36" />
      <xs:maxLength value="36" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="VersionType">
    <xs:annotation>
      <xs:documentation>Version pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="\\d+\\.\\d+(\\.\\d+)?" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CwereferenceType">
    <xs:annotation>
      <xs:documentation>Cwe Reference pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="CWE-\\d+" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OwaspreferenceType">
    <xs:annotation>
      <xs:documentation>Owasp Reference pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="A\\d{1,2}:\\d{4}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="FilepathType">
    <xs:annotation>
      <xs:documentation>File Path pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="[^\\0]+" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="LinerangeType">
    <xs:annotation>
      <xs:documentation>Line Range pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="\\d+(-\\d+)?" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CodesnippetType">
    <xs:annotation>
      <xs:documentation>Code Snippet pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value=".{1,5000}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="QualityCharacteristicType">
    <xs:annotation>
      <xs:documentation>ISO/IEC 5055 Core Quality Characteristics</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Reliability">
        <xs:annotation>
          <xs:documentation>Degree to which a system performs specified functions under specified conditions</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Security">
        <xs:annotation>
          <xs:documentation>Degree to which information and data are protected</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Performance Efficiency">
        <xs:annotation>
          <xs:documentation>Performance relative to the amount of resources used</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Maintainability">
        <xs:annotation>
          <xs:documentation>Degree of effectiveness and efficiency with which the product can be modified</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ReliabilityMeasureType">
    <xs:annotation>
      <xs:documentation>Reliability Quality Measures</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Null Pointer Dereference">
        <xs:annotation>
          <xs:documentation>Accessing memory through null pointer</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Resource Management">
        <xs:annotation>
          <xs:documentation>Improper resource allocation/deallocation</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Memory Corruption">
        <xs:annotation>
          <xs:documentation>Buffer overflow and memory violations</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Synchronization Issues">
        <xs:annotation>
          <xs:documentation>Race conditions and deadlocks</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Exception Handling">
        <xs:annotation>
          <xs:documentation>Improper error and exception handling</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Type Conversion">
        <xs:annotation>
          <xs:documentation>Unsafe type conversions</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="API Misuse">
        <xs:annotation>
          <xs:documentation>Incorrect API usage patterns</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Data Integrity">
        <xs:annotation>
          <xs:documentation>Data corruption vulnerabilities</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SecurityMeasureType">
    <xs:annotation>
      <xs:documentation>Security Quality Measures</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Input Validation">
        <xs:annotation>
          <xs:documentation>Improper input validation and sanitization</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SQL Injection">
        <xs:annotation>
          <xs:documentation>SQL injection vulnerabilities</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XSS">
        <xs:annotation>
          <xs:documentation>Cross-site scripting vulnerabilities</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Path Traversal">
        <xs:annotation>
          <xs:documentation>Directory traversal vulnerabilities</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Command Injection">
        <xs:annotation>
          <xs:documentation>OS command injection</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Authentication">
        <xs:annotation>
          <xs:documentation>Weak authentication mechanisms</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Cryptography">
        <xs:annotation>
          <xs:documentation>Weak cryptographic practices</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Session Management">
        <xs:annotation>
          <xs:documentation>Improper session handling</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Access Control">
        <xs:annotation>
          <xs:documentation>Broken access control</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Information Exposure">
        <xs:annotation>
          <xs:documentation>Sensitive data exposure</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PerformanceMeasureType">
    <xs:annotation>
      <xs:documentation>Performance Efficiency Quality Measures</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Algorithm Complexity">
        <xs:annotation>
          <xs:documentation>Inefficient algorithms</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Database Performance">
        <xs:annotation>
          <xs:documentation>Inefficient database operations</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Memory Leaks">
        <xs:annotation>
          <xs:documentation>Memory not properly released</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Resource Contention">
        <xs:annotation>
          <xs:documentation>Excessive resource locking</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Caching Issues">
        <xs:annotation>
          <xs:documentation>Improper or missing caching</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Network Latency">
        <xs:annotation>
          <xs:documentation>Excessive network calls</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Loop Inefficiency">
        <xs:annotation>
          <xs:documentation>Inefficient loop constructs</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="String Operations">
        <xs:annotation>
          <xs:documentation>Inefficient string handling</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MaintainabilityMeasureType">
    <xs:annotation>
      <xs:documentation>Maintainability Quality Measures</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Code Complexity">
        <xs:annotation>
          <xs:documentation>High cyclomatic complexity</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Code Duplication">
        <xs:annotation>
          <xs:documentation>Duplicated code blocks</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Dead Code">
        <xs:annotation>
          <xs:documentation>Unreachable or unused code</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Documentation">
        <xs:annotation>
          <xs:documentation>Missing or inadequate documentation</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Naming Conventions">
        <xs:annotation>
          <xs:documentation>Poor naming standards</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Coupling">
        <xs:annotation>
          <xs:documentation>High coupling between modules</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Cohesion">
        <xs:annotation>
          <xs:documentation>Low cohesion within modules</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Architecture Violations">
        <xs:annotation>
          <xs:documentation>Violations of architectural patterns</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ViolationSeverityType">
    <xs:annotation>
      <xs:documentation>ViolationSeverityType</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Info">
        <xs:annotation>
          <xs:documentation>Informational finding</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Minor">
        <xs:annotation>
          <xs:documentation>Minor issue with minimal impact</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Major">
        <xs:annotation>
          <xs:documentation>Significant issue requiring attention</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Critical">
        <xs:annotation>
          <xs:documentation>Critical issue requiring immediate action</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Blocker">
        <xs:annotation>
          <xs:documentation>Blocking issue preventing release</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RemediationPriorityType">
    <xs:annotation>
      <xs:documentation>RemediationPriorityType</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Immediate" />
      <xs:enumeration value="High" />
      <xs:enumeration value="Medium" />
      <xs:enumeration value="Low" />
      <xs:enumeration value="Deferred" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="LanguageType">
    <xs:annotation>
      <xs:documentation>LanguageType</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Java" />
      <xs:enumeration value="C" />
      <xs:enumeration value="C++" />
      <xs:enumeration value="C#" />
      <xs:enumeration value="Python" />
      <xs:enumeration value="JavaScript" />
      <xs:enumeration value="TypeScript" />
      <xs:enumeration value="Go" />
      <xs:enumeration value="Rust" />
      <xs:enumeration value="Swift" />
      <xs:enumeration value="Kotlin" />
      <xs:enumeration value="Ruby" />
      <xs:enumeration value="PHP" />
      <xs:enumeration value="COBOL" />
      <xs:enumeration value="SQL" />
      <xs:enumeration value="ABAP" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="FrameworkType">
    <xs:annotation>
      <xs:documentation>FrameworkType</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Spring" />
      <xs:enumeration value="Django" />
      <xs:enumeration value="React" />
      <xs:enumeration value="Angular" />
      <xs:enumeration value="Vue" />
      <xs:enumeration value=".NET" />
      <xs:enumeration value="Rails" />
      <xs:enumeration value="Express" />
      <xs:enumeration value="Flask" />
      <xs:enumeration value="Laravel" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="AssessmentStatusType">
    <xs:annotation>
      <xs:documentation>AssessmentStatusType</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Pending" />
      <xs:enumeration value="In Progress" />
      <xs:enumeration value="Completed" />
      <xs:enumeration value="Failed" />
      <xs:enumeration value="Partial" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ComponentTypeType">
    <xs:annotation>
      <xs:documentation>ComponentTypeType</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Application" />
      <xs:enumeration value="Service" />
      <xs:enumeration value="Library" />
      <xs:enumeration value="Module" />
      <xs:enumeration value="Package" />
      <xs:enumeration value="Class" />
      <xs:enumeration value="Function" />
