  </xs:simpleType>
  <xs:simpleType name="CodeCoverageType">
    <xs:annotation>
      <xs:documentation>CodeCoverage percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ConfidenceType">
    <xs:annotation>
      <xs:documentation>Confidence percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SimilarityType">
    <xs:annotation>
      <xs:documentation>Similarity percentage value 0-100</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PrecedenceType">
    <xs:annotation>
      <xs:documentation>Operator precedence level</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="1000" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ComplexityScoreType">
    <xs:annotation>
      <xs:documentation>Cyclomatic complexity</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="10000" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="NestingLevelType">
    <xs:annotation>
      <xs:documentation>Maximum nesting depth</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ArityValueType">
    <xs:annotation>
      <xs:documentation>Function arity</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="255" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="GUIDType">
    <xs:annotation>
      <xs:documentation>UUID/GUID pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" />
      <xs:minLength value="36" />
      <xs:maxLength value="36" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="IdentifierType">
    <xs:annotation>
      <xs:documentation>Identifier pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="[a-zA-Z_][a-zA-Z0-9_]*" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="QualifiednameType">
    <xs:annotation>
      <xs:documentation>Qualified Name pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="VersionpatternType">
    <xs:annotation>
      <xs:documentation>Version Pattern pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="\\d+\\.\\d+(\\.\\d+)?(-[a-zA-Z0-9]+)?" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SourcelocationType">
    <xs:annotation>
      <xs:documentation>Source Location pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="\\d+:\\d+(-\\d+:\\d+)?" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="BinaryliteralType">
    <xs:annotation>
      <xs:documentation>Binary Literal pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="0[bB][01]+" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="HexliteralType">
    <xs:annotation>
      <xs:documentation>Hex Literal pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="0[xX][0-9a-fA-F]+" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OctalliteralType">
    <xs:annotation>
      <xs:documentation>Octal Literal pattern</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="0[oO]?[0-7]+" />
    </xs:restriction>
  </xs:simpleType>
