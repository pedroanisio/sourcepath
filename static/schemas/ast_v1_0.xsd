<?xml version='1.0' encoding='utf-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://schemas.ast.org/universal/v1/2025" xmlns:tns="https://schemas.ast.org/universal/v1/2025" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
  <xs:annotation>
    <xs:documentation>Universal AST schema for representing any programming language or formal system</xs:documentation>
  </xs:annotation>
  <xs:simpleType name="NodeIDType">
    <xs:annotation>
      <xs:documentation>NodeID identifier pattern NODE-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:pattern value="NODE-\\d{4}-\\d{3}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeIDType">
    <xs:annotation>
      <xs:documentation>TypeID identifier pattern TYPE-YYYY-NNN</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
