    arch:inRegion "providers/ tree" ;
    rdfs:seeAlso afx:Region_Providers ;
    arch:confidenceLevel "Medium" .
afx:Ev_D01_Providers a arch:EvidenceRecord ;
    arch:evidenceSummary "The providers/src/airflow/providers/ tree and 171 dependency-manifest files show decomposition by external integration — one provider package per system (aws, google, http, ...). Tree presence is mechanically verified." .

