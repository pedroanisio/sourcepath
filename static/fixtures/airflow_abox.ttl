afx:Ev_D18 a arch:EvidenceRecord ;
    arch:evidenceSummary "272 opentelemetry/statsd references indicate metrics and tracing instrumentation; task logs and a web UI provide operator inspection and control (pause/trigger). Telemetry-library presence verified; correlation discipline and control levers inferred." .

afx:App_D19_Security
    a arch:DimensionApplication ;
    rdfs:label "Airflow — Security and trust-boundary model" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D19_SecurityAndTrustBoundaryModel ;
    arch:usesClassificationValue afx:PluggableAuthManagerSecurity, arch:PerimeterSecurityModel, afx:AmbientWorkerAuthority ;
    arch:dominantValue arch:PerimeterSecurityModel ;
    arch:supportedByEvidence afx:Ev_D19 ;
    arch:revealsRisk afx:Risk_D19_SingleTenantTrust ;
    arch:atScope "system" ;
    arch:confidenceLevel "Medium" .

afx:Ev_D19 a arch:EvidenceRecord ;
    arch:evidenceSummary "2,291 auth_manager/fab/rbac/permissions references show a pluggable auth-manager with role-based access control at the API/UI perimeter. Auth surface verified; per-object authorization and tenant isolation strength are inferred, not measured." .

afx:App_D20_BuildDelivery
    a arch:DimensionApplication ;
    rdfs:label "Airflow — Build and delivery model" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D20_BuildAndDeliveryModel ;
    arch:usesClassificationValue arch:TrunkBasedDeliveryModel, afx:HatchMonorepoBuild ;
    arch:supportedByEvidence afx:Ev_D20 ;
    arch:atScope "system" ;
    arch:confidenceLevel "Medium" .

afx:Ev_D20 a arch:EvidenceRecord ;
    arch:evidenceSummary "477 pyproject.toml references (hatchling-based packaging across monorepo packages), 55 .github/workflows references, 45 CI/CD files, and 13 lockfiles indicate a CI-gated, multi-package build/delivery pipeline publishing to PyPI. Build/CI artifacts verified; reproducibility and signing posture inferred." .

#################################################################
# Risk findings (Layer-2 diagnostics lifted from flagged failure modes)
#################################################################

afx:Risk_D03_DbAsConnector a arch:RiskFinding ;
    rdfs:label "Metadata database as connector" ;
    rdfs:comment "Scheduler-side coordination flows through the shared metadata database — the database-as-connector failure mode D03 names. Scenario: schema change or database saturation couples otherwise independent components. Interpretation over verified module evidence." .

afx:Risk_D02_UnverifiedAcyclicity a arch:RiskFinding ;
    rdfs:label "Core-to-provider acyclicity unverified" ;
    rdfs:comment "Intended DAG topology (providers depend on core, not vice versa) was not cycle-checked over the 20,355 extracted import edges. Evidence-gathering action: run a cycle detector on the emitted import graph; settles D02 confidence either way." .

afx:Risk_D19_SingleTenantTrust a arch:RiskFinding ;
    rdfs:label "Single-tenant trust model" ;
    rdfs:comment "DAG code executes with worker authority; isolation between DAG authors lies outside the RBAC perimeter, consistent with Airflow's documented security model. Knowledge-based; verify against current security documentation." .

#################################################################
# LAYERED ANALYSIS — region-scoped applications
#
# Each block below is a second (or third/fourth) application of a dimension
# already applied at system scope above. They share arch:classifiesSystem +
# arch:appliesDimension and differ only by arch:atScope / arch:inRegion, which
# is the framework's representation of a layered system. rdfs:seeAlso links the
# reified afx:Region_* individual. The matching system-scope application names
# the arch:dominantValue that these regional values roll up into.
#################################################################

##### D01 Decomposition — core (by component) vs providers (by integration)
afx:App_D01_CoreRegion
    a arch:DimensionApplication ;
