    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D01_DecompositionModel ;
    arch:usesClassificationValue afx:ByRuntimeComponent ;
    arch:dominantValue afx:ByRuntimeComponent ;
    arch:supportedByEvidence afx:Ev_D01_Core ;
    arch:atScope "subsystem" ;
    arch:inRegion "airflow-core" ;
    rdfs:seeAlso afx:Region_Core ;
    arch:confidenceLevel "Medium" .
afx:Ev_D01_Core a arch:EvidenceRecord ;
    arch:evidenceSummary "airflow-core is partitioned by runtime component (scheduler, api-server, dag-processor, triggerer, executors, task-sdk), each an independently runnable process. Component modules are present in the inventory; the boundary criterion is interpretive." .

afx:App_D01_ProvidersRegion
    a arch:DimensionApplication ;
    rdfs:label "Airflow providers region — Decomposition model" ;
    arch:classifiesSystem afx:AirflowSystem ;
