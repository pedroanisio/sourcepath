    arch:confidenceLevel "Medium" .

afx:Ev_D17 a arch:EvidenceRecord ;
    arch:evidenceSummary "994 TypeScript files (statically typed UI) plus openapi/Task-SDK schemas indicate runtime schema validation on API boundaries alongside static typing; Python core mixes type hints with dynamic typing. TS count and schema presence verified; Python typing strictness inferred." .

afx:App_D18_Observability
    a arch:DimensionApplication ;
    rdfs:label "Airflow — Operational observability and control model" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D18_OperationalObservabilityAndControlModel ;
