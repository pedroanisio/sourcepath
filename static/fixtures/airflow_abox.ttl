    arch:confidenceLevel "Low" .

afx:Ev_D16 a arch:EvidenceRecord ;
    arch:evidenceSummary "Python exception-based error propagation is expected, with task-level retries and up-for-retry state in the scheduler as the recovery mechanism. Not structurally measured in this run; classification is knowledge-based, confidence Low." .

afx:App_D17_TypeDiscipline
    a arch:DimensionApplication ;
    rdfs:label "Airflow — Type and data discipline" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D17_TypeAndDataDiscipline ;
    arch:usesClassificationValue arch:RuntimeSchemaDiscipline, arch:StaticTypeDiscipline, afx:GradualTypeDiscipline ;
