    arch:confidenceLevel "Medium" .
sqx:Ev_D14_CoreC a arch:EvidenceRecord ;
    arch:evidenceSummary "357 C files implement the engine in a procedural paradigm, executing prepared statements via a bytecode interpreter (VDBE). Language dominance verified; paradigm attribution interpretive." .

sqx:App_D14_Jni
    a arch:DimensionApplication ; rdfs:label "JNI Java bindings — Programming paradigm model" ;
    arch:classifiesSystem sqx:SqliteSystem ; arch:appliesDimension arch:D14_ProgrammingParadigmModel ;
