sqx:Ev_D14_Jni a arch:EvidenceRecord ;
    arch:evidenceSummary "58 Java files (ext/jni, 151 jni/wasm/jdbc references) wrap the C engine in an object-oriented JVM API. File count verified; OO attribution is a convention-based inference." .

sqx:App_D14_Wasm
    a arch:DimensionApplication ; rdfs:label "WASM/JS bindings — Programming paradigm model" ;
    arch:classifiesSystem sqx:SqliteSystem ; arch:appliesDimension arch:D14_ProgrammingParadigmModel ;
    arch:usesClassificationValue arch:ObjectOrientedParadigm ; arch:dominantValue arch:ObjectOrientedParadigm ;
    arch:supportedByEvidence sqx:Ev_D14_Wasm ; arch:atScope "language-region" ;
    arch:inRegion "WASM/JavaScript bindings" ; rdfs:seeAlso sqx:Region_WasmJs ;
    arch:confidenceLevel "Low" .
sqx:Ev_D14_Wasm a arch:EvidenceRecord ;
    arch:evidenceSummary "42 JavaScript files (ext/wasm) provide an object-oriented (oo1) JS API over the WASM build. File count verified; OO attribution is a convention-based inference." .

##### D17 Type discipline — static C vs SQL manifest typing
sqx:App_D17_CImpl
    a arch:DimensionApplication ; rdfs:label "C implementation — Type and data discipline" ;
    arch:classifiesSystem sqx:SqliteSystem ; arch:appliesDimension arch:D17_TypeAndDataDiscipline ;
    arch:usesClassificationValue arch:StaticTypeDiscipline ; arch:dominantValue arch:StaticTypeDiscipline ;
    arch:supportedByEvidence sqx:Ev_D17_C ; arch:atScope "language-region" ;
    arch:inRegion "core C implementation" ; rdfs:seeAlso sqx:Region_CoreC ;
    arch:confidenceLevel "Medium" .
sqx:Ev_D17_C a arch:EvidenceRecord ;
    arch:evidenceSummary "The implementation is statically typed C (357 files). Language dominance verified; hint/annotation strictness not measured here." .

sqx:App_D17_SqlValues
    a arch:DimensionApplication ; rdfs:label "SQL value system — Type and data discipline" ;
    arch:classifiesSystem sqx:SqliteSystem ; arch:appliesDimension arch:D17_TypeAndDataDiscipline ;
    arch:usesClassificationValue sqx:ManifestTypingDiscipline ; arch:dominantValue sqx:ManifestTypingDiscipline ;
    arch:supportedByEvidence sqx:Ev_D17_Sql ; arch:atScope "subsystem" ;
    arch:inRegion "SQL value/type system" ; rdfs:seeAlso sqx:Region_SqlValues ;
    arch:confidenceLevel "Medium" .
sqx:Ev_D17_Sql a arch:EvidenceRecord ;
    arch:evidenceSummary "At the SQL layer, types belong to values (manifest typing) with column type affinity (16 affinity/type-code references) — a dynamic discipline layered atop the static C engine. Documented at sqlite.org/datatype3.html." .

##### D19 Security — host authority vs untrusted-input vs authorizer
sqx:App_D19_HostAuthority
    a arch:DimensionApplication ; rdfs:label "In-process host authority — Security model" ;
    arch:classifiesSystem sqx:SqliteSystem ; arch:appliesDimension arch:D19_SecurityAndTrustBoundaryModel ;
    arch:usesClassificationValue sqx:InProcessHostAuthority ; arch:dominantValue sqx:InProcessHostAuthority ;
    arch:supportedByEvidence sqx:Ev_D19_Host ; arch:atScope "subsystem" ;
    arch:inRegion "host process authority" ; rdfs:seeAlso sqx:Region_HostProcess ;
    arch:revealsRisk sqx:Risk_D19_HostAuthority ; arch:confidenceLevel "High" .
sqx:Ev_D19_Host a arch:EvidenceRecord ;
    arch:evidenceSummary "SQLite introduces no trust boundary of its own — it runs with the host process's authority. Definitional for an embedded library; isolation is the host's responsibility." .

sqx:App_D19_UntrustedInput
    a arch:DimensionApplication ; rdfs:label "Untrusted-input hardening — Security model" ;
    arch:classifiesSystem sqx:SqliteSystem ; arch:appliesDimension arch:D19_SecurityAndTrustBoundaryModel ;
    arch:usesClassificationValue sqx:UntrustedInputHardening ; arch:dominantValue sqx:UntrustedInputHardening ;
    arch:supportedByEvidence sqx:Ev_D19_Input ; arch:atScope "subsystem" ;
    arch:inRegion "untrusted DB file + SQL text" ; rdfs:seeAlso sqx:Region_UntrustedInput ;
    arch:confidenceLevel "Medium" .
sqx:Ev_D19_Input a arch:EvidenceRecord ;
    arch:evidenceSummary "The database file and SQL text crossing into the engine are treated as potentially hostile; SQLite is explicitly hardened (fuzz-tested, corruption-resistant) against malicious databases. Hardening is a documented design goal (sqlite.org/security.html); tested via the corpus but the posture is documented, not measured here." .

sqx:App_D19_Authorizer
    a arch:DimensionApplication ; rdfs:label "Authorizer callback — Security model" ;
    arch:classifiesSystem sqx:SqliteSystem ; arch:appliesDimension arch:D19_SecurityAndTrustBoundaryModel ;
    arch:usesClassificationValue sqx:AuthorizerCallbackControl ; arch:dominantValue sqx:AuthorizerCallbackControl ;
    arch:supportedByEvidence sqx:Ev_D19_Authz ; arch:atScope "module" ;
    arch:inRegion "authorizer access-control hook" ; rdfs:seeAlso sqx:Region_HostProcess ;
    arch:confidenceLevel "Medium" .
sqx:Ev_D19_Authz a arch:EvidenceRecord ;
    arch:evidenceSummary "An optional host-supplied authorizer callback (sqlite3_set_authorizer, auth.c — 22 references) can allow/deny individual SQL actions at prepare time. Authorizer surface mechanically verified; policy is the host's." .
