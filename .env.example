# codebase-mapper — environment variable reference
#
# This file is the canonical inventory of every environment variable
# read anywhere in the codebase. `tests/verify_drift_p1.py` greps the
# source tree for env reads and asserts the resulting set matches the
# keys defined here. Copy this file to `.env` and adjust per deployment.
#
# Categories below match where each variable is consumed.

# ────────────────────────────────────────────────────────────────────
# Backend (frontend/backend/app.py)
# ────────────────────────────────────────────────────────────────────

# Single-bundle path (frontend/backend reads bundle files from here when set).
# Honored first; falls through to CBM_BUNDLES_ROOT when unset/missing.
CBM_OUTPUT_DIR=/data

# Multi-bundle root (frontend/backend + mcp_server enumerate this directory).
CBM_BUNDLES_ROOT=/data

# Static bearer token for the /api/* surface. Empty = no static token
# (combine with CBM_ALLOW_ANONYMOUS to permit unauthenticated access).
CBM_API_TOKEN=

# Set to "1" to allow unauthenticated /api/* access. Anything else = deny.
CBM_ALLOW_ANONYMOUS=

# Comma-separated CORS allow-list for the browser UI. Unset falls back to the
# Vite dev-server + compose-nginx origins (localhost/127.0.0.1 on :5173 and :8080).
CBM_CORS_ORIGINS=

# ────────────────────────────────────────────────────────────────────
# Repository ingestion (codebase_mapper/inspection/repo_source.py)
# ────────────────────────────────────────────────────────────────────

# Working directory for Git clones during --repo ingestion. Unset = a
# system temp dir. Point it at the same filesystem as the output dir to
# avoid a cross-device copy of large clones.
CBM_WORK_DIR=

# Opt-in deepening of the default `--depth 1` clone: when set to 1/true/yes,
# a best-effort `git fetch --unshallow --filter=blob:none` runs after the
# shallow clone, recovering commit history (per-file gitCommitTime
# provenance) without downloading historical blobs. Unset/0 = stay shallow;
# the pipeline then omits git_commit_time and records a git_provenance
# degradation instead of fabricating times from the lone tip commit.
CBM_UNSHALLOW=

# ────────────────────────────────────────────────────────────────────
# MCP server (frontend/mcp_server/*)
# ────────────────────────────────────────────────────────────────────

# Poll interval (seconds) for the watcher that picks up new bundles.
CBM_WATCH_INTERVAL=30

# Static bearer token (legacy auth path). Leave unset to disable.
CBM_MCP_TOKEN=

# Absolute path for the structured audit log. Unset = no audit log.
CBM_MCP_AUDIT_LOG_PATH=

# OAuth scope required to call any tool. Defaults to "bundle:read".
CBM_MCP_REQUIRED_SCOPE=bundle:read

# JWT validation (RFC 7519). All five vars are read together; CBM_MCP_JWT_AUDIENCE
# being non-empty enables JWT mode and at least one of PUBLIC_KEY / JWKS_URI
# must be set. Unset = legacy bearer-token mode (via CBM_MCP_TOKEN).
CBM_MCP_JWT_AUDIENCE=
CBM_MCP_JWT_ISSUER=
CBM_MCP_JWT_PUBLIC_KEY=
CBM_MCP_JWT_JWKS_URI=
# Comma-separated; defaults to "RS256". Honoured only when JWT mode is enabled.
CBM_MCP_JWT_ALGORITHMS=RS256

# DANGER: gates the read-only SPARQL tool. "1"/"true"/"yes"/"on" enables it.
# Unset by default — opt-in only.
CBM_ENABLE_SPARQL=

# ────────────────────────────────────────────────────────────────────
# LLM enrichment (plugins/llm_enrich/*)
# ────────────────────────────────────────────────────────────────────

# Cache directory for LLM enrichments. Required for offline/CI determinism.
CBM_LLM_CACHE=

# Ollama HTTP endpoint (when the llm_enrich plugin emits live calls).
OLLAMA_HOST=http://localhost:11434

# ────────────────────────────────────────────────────────────────────
# Pipeline concurrency (codebase_mapper/inspection/pipeline.py)
# ────────────────────────────────────────────────────────────────────

# Threads for the AST-extraction pass. Default: all cores (tree-sitter
# releases the GIL during parse). Garbage/non-positive values degrade
# to 1 (serial) with a logged warning; output is identical either way.
CBM_EXTRACT_WORKERS=

# Threads for the record-enricher pass (parallel-safe enrichers only —
# e.g. L4's LLM calls, which are I/O-bound). Default: 4. Degrades to 1
# on garbage values; bundle output is order-independent and identical.
CBM_ENRICH_WORKERS=

# ────────────────────────────────────────────────────────────────────
# Report / dossier rendering (scripts/cbm_dossier.py)
# ────────────────────────────────────────────────────────────────────

# Directory holding the dossier's designed TTF set (Bricolage Grotesque,
# IBM Plex Serif/Mono, Big Shoulders, Arsenal SC). When unset or absent,
# the renderer falls back to built-in PDF faces and says so on stderr.
CBM_FONT_DIR=

# ────────────────────────────────────────────────────────────────────
# Test-only (NOT part of the deployment surface)
# ────────────────────────────────────────────────────────────────────

# Set to "1" to keep temporary bundle directories after xref tests run
# (debugging aid). Never set in production.
# XREF_TEST_KEEP=
