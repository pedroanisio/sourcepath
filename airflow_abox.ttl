#################################################################
# Evidence basis & confidence (operator-approved split disclosure)
#
# ARCHITECTURAL REQUIREMENT (PALS's LAW): LLMs will always produce some
# form of error. Absence of output verification is a design defect, not a
# runtime bug. All LLM output must be treated as untrusted and validated.
#
# This ABox mixes two epistemic classes; every arch:DimensionApplication
# carries an explicit arch:confidenceLevel:
#
#   * MECHANICALLY EXTRACTED — file counts, language mix, import-edge
#     counts, and the presence of specific paths (alembic migrations,
#     openapi specs, executor modules, helm chart, pyproject packages,
#     opentelemetry/statsd, auth_manager) were produced by
#     codebase-mapper v0.5.0 over Apache Airflow at commit
#     01b425a06f6998950cada673582a17b6b2264b41 and confirmed by grep over
#     the emitted inventory.ttl. These are evidence-backed facts.
#
#   * LLM-SYNTHESIZED INTERPRETATION — the mapping from those facts to a
#     dimensional CLASSIFICATION (e.g. "acyclic dependency topology",
#     "database-mediated connector", "perimeter security model") is an
#     inference authored by an LLM. It is confidence-tagged and MUST be
#     validated against the running system before high-stakes decisions.
#
# generated_by: "Claude Opus 4.8 via Claude Code"
# date: "2026-07-08"
# tbox: software_architecture_dimensions.ttl (arch:ScopeAFramework, owl:versionInfo 2.0.3-scope-a)
#################################################################

afx:AirflowAboxGraph
    a owl:Ontology ;
    dcterms:title "Scope A dimension ABox — Apache Airflow" ;
    dcterms:description "Classification of Apache Airflow under the 20 Scope-A core system dimensions. Structural facts are mechanically extracted by codebase-mapper; dimensional classifications are LLM-synthesized and confidence-tagged." ;
    dcterms:created "2026-07-08"^^xsd:date ;
    dcterms:source <https://github.com/apache/airflow> ;
    dcterms:creator "Claude Opus 4.8 via Claude Code (extraction: codebase-mapper v0.5.0)" ;
    dcterms:conformsTo <https://w3id.org/arc4d3/software-architecture-dimensions#> ;
    owl:imports <https://w3id.org/arc4d3/software-architecture-dimensions#> ;
    owl:versionInfo "1.0.2-airflow-abox" ;
    rdfs:comment "1.0.1 (review pass): afx classification values registered on their dimensions; execution-API connector and event-loop runtime region added from the file's own task-sdk/triggerer evidence; D05 writer set corrected to match the execution-API boundary; arch:atScope recorded on all applications; three flagged failure modes lifted into arch:RiskFinding instances; provenance lifted from comments into triples." ;
    rdfs:comment "1.0.2 (layered-state demo): region-scoped application afx:App_D06_TriggererRegion added alongside the system-scope D06 application, exercising arch:inRegion and multi-application layering; system-scope D06 names arch:BatchRuntime as arch:dominantValue." .

#################################################################
# System under classification
#################################################################

afx:AirflowSystem
    a arch:ImplementedSoftwareSystem ;
    skos:prefLabel "Apache Airflow"@en ;
    rdfs:comment "Apache Airflow — a workflow orchestration platform. Classified from the implemented system at commit 01b425a0 (13,415 files; 7,569 Python, 994 TypeScript, 94 Go, 42 Kotlin source files; 20,355 import edges, 6,169 external; 4,854 source-code and 4,027 test-code files as typed by codebase-mapper v0.5.0)." ;
    dcterms:identifier "apache/airflow@01b425a06f6998950cada673582a17b6b2264b41" ;
    rdfs:seeAlso <https://github.com/apache/airflow> .

# Assessment overlay (O01) is NOT a peer core dimension and cannot be an
# arch:DimensionApplication (its shape requires a arch:CoreSystemDimension).
# Recorded here as a prose reading only, per the TBox constraint.
afx:AirflowSystem
    rdfs:comment "Quality-attribute overlay reading (O01, LLM-synthesized, Low confidence): revealed priorities appear ordered as evolvability/extensibility (large provider ecosystem, pluggable executors and auth managers) and operability (opentelemetry/statsd telemetry, health endpoints) ahead of strict consistency (metadata-database-mediated coordination) and low operational footprint. This is a cross-dimensional diagnosis, not an orthogonal dimension." .

#################################################################
# Airflow-specific classification values
# (typed arch:ClassificationValue; extend the TBox's example archetypes
#  where no example value fits Airflow precisely)
#################################################################

afx:ByProviderIntegration a arch:ClassificationValue ; skos:prefLabel "decomposition by provider integration"@en .
afx:ByRuntimeComponent    a arch:ClassificationValue ; skos:prefLabel "decomposition by runtime component"@en .
afx:MetadataDatabaseConnector a arch:ClassificationValue ; skos:prefLabel "metadata-database-mediated connector"@en .
afx:ProviderPluginComposition a arch:ClassificationValue ; skos:prefLabel "provider-package plugin composition"@en .
afx:PluggableExecutorComposition a arch:ClassificationValue ; skos:prefLabel "pluggable executor composition"@en .
afx:ConfigurationDrivenVariability a arch:ClassificationValue ; skos:prefLabel "configuration-driven variability"@en .
afx:PluggableAuthManagerSecurity a arch:ClassificationValue ; skos:prefLabel "pluggable auth-manager and RBAC security model"@en .
afx:HatchMonorepoBuild a arch:ClassificationValue ; skos:prefLabel "hatchling monorepo package build"@en .
afx:ExecutionApiConnector a arch:ClassificationValue ; skos:prefLabel "task execution API connector"@en .

# Register minted values on their dimensions so the extension is explicit
# and queryable via arch:hasClassificationValue (not merely used ad hoc).
arch:D01_DecompositionModel arch:hasClassificationValue afx:ByProviderIntegration, afx:ByRuntimeComponent .
arch:D03_ConnectorAndInteractionModel arch:hasClassificationValue afx:MetadataDatabaseConnector, afx:ExecutionApiConnector .
arch:D10_CompositionAndReuseModel arch:hasClassificationValue afx:ProviderPluginComposition, afx:PluggableExecutorComposition .
arch:D12_VariabilityAndConfigurationSpaceModel arch:hasClassificationValue afx:ConfigurationDrivenVariability .
arch:D19_SecurityAndTrustBoundaryModel arch:hasClassificationValue afx:PluggableAuthManagerSecurity .
arch:D20_BuildAndDeliveryModel arch:hasClassificationValue afx:HatchMonorepoBuild .

#################################################################
# Dimension applications (20)
#################################################################

afx:App_D01_Decomposition
    a arch:DimensionApplication ;
    rdfs:label "Airflow — Decomposition model" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D01_DecompositionModel ;
    arch:usesClassificationValue afx:ByProviderIntegration, afx:ByRuntimeComponent, arch:ByFeature ;
    arch:supportedByEvidence afx:Ev_D01 ;
    arch:atScope "system" ;
    arch:confidenceLevel "Medium" .

afx:Ev_D01 a arch:EvidenceRecord ;
    arch:evidenceSummary "Repository exposes a providers/src/airflow/providers/ tree and 171 dependency-manifest files, indicating decomposition by integration (one provider package per external system) layered over runtime components (scheduler, api-server, dag-processor, triggerer, executors, task-sdk). Component boundaries are inferred; provider tree presence is mechanically verified." .

afx:App_D02_DependencyTopology
    a arch:DimensionApplication ;
    rdfs:label "Airflow — Dependency topology" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D02_DependencyTopology ;
    arch:usesClassificationValue arch:DAGDependencies ;
    arch:revealsRisk afx:Risk_D02_UnverifiedAcyclicity ;
    arch:supportedByEvidence afx:Ev_D02 ;
    arch:atScope "system" ;
    arch:confidenceLevel "Low" .

afx:Ev_D02 a arch:EvidenceRecord ;
    arch:evidenceSummary "codebase-mapper counted 20,355 import edges (6,169 external). Intended topology is core -> providers (providers depend on airflow-core, not vice versa), i.e. a DAG. Actual acyclicity was NOT verified in this run; classification confidence is Low pending a cycle check on the import graph." .

afx:App_D03_Connector
    a arch:DimensionApplication ;
    rdfs:label "Airflow — Connector and interaction model" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D03_ConnectorAndInteractionModel ;
    arch:usesClassificationValue afx:MetadataDatabaseConnector, afx:ExecutionApiConnector, arch:MessageQueueConnector ;
    arch:supportedByEvidence afx:Ev_D03 ;
    arch:revealsRisk afx:Risk_D03_DbAsConnector ;
    arch:atScope "system" ;
    arch:confidenceLevel "Medium" .

afx:Ev_D03 a arch:EvidenceRecord ;
    arch:evidenceSummary "Executor modules for celery and kubernetes are present (150 references to celery_executor/kubernetes_executor), and 2,183 task-sdk/task_sdk references evidence a Task Execution API boundary (consistent with Ev_D04). Scheduler-side coordination is metadata-database-mediated (a database-as-connector pattern the TBox flags as a failure mode; recorded as afx:Risk_D03_DbAsConnector); worker task execution crosses an HTTP execution-API connector via the Task SDK, with a message broker under CeleryExecutor. Module and task-sdk presence verified; coordination semantics are architectural interpretation." .

afx:App_D04_Contract
    a arch:DimensionApplication ;
    rdfs:label "Airflow — Interface and contract model" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D04_InterfaceAndContractModel ;
    arch:usesClassificationValue arch:SchemaFirstContract ;
    arch:supportedByEvidence afx:Ev_D04 ;
    arch:atScope "system" ;
    arch:confidenceLevel "Medium" .

afx:Ev_D04 a arch:EvidenceRecord ;
    arch:evidenceSummary "1,380 openapi references and 2,183 task-sdk/task_sdk references in the inventory indicate a schema-first REST API plus a versioned Task SDK / execution-API boundary between workers and the core. Presence is verified; contract-enforcement discipline is inferred. Whether specs are authored first or generated from server code (code-first-published) was not determined in this run." .

afx:App_D05_StateOwnership
    a arch:DimensionApplication ;
    rdfs:label "Airflow — State and data ownership model" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D05_StateAndDataOwnershipModel ;
    arch:usesClassificationValue arch:SharedDatabaseOwnership ;
    arch:supportedByEvidence afx:Ev_D05 ;
    arch:atScope "system" ;
    arch:confidenceLevel "Medium" .

afx:Ev_D05 a arch:EvidenceRecord ;
    arch:evidenceSummary "SQLAlchemy models (models/dagrun, models/taskinstance) and 315 alembic references confirm a single central metadata database as authoritative state, written directly by scheduler, dag-processor, and API server; under the Task SDK boundary, workers reach state through the execution API rather than direct writes (consistent with Ev_D04). Multiple core writers over one shared store is the observed ownership regime; write-authority partitioning is inferred." .

afx:App_D06_RuntimeExecution
    a arch:DimensionApplication ;
    rdfs:label "Airflow — Runtime execution model" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D06_RuntimeExecutionModel ;
    arch:usesClassificationValue arch:BatchRuntime, arch:ThreadPerRequestRuntime, arch:EventLoopRuntime ;
    arch:dominantValue arch:BatchRuntime ;
    arch:supportedByEvidence afx:Ev_D06 ;
    arch:atScope "system" ;
    arch:confidenceLevel "Low" .

afx:Ev_D06 a arch:EvidenceRecord ;
    arch:evidenceSummary "Executor modules (local, celery, kubernetes, base) are verified present. Airflow runs a long-lived scheduler loop dispatching batch task instances to worker processes/pods. Presence of triggerer and api-server modules supports asyncio event-loop regions (deferrable-operator triggerer; ASGI API server) alongside the scheduler loop and batch dispatch. Concurrency detail (loop cadence, parallelism limits) is knowledge-based, not extracted; confidence Low." .

afx:App_D07_Deployment
    a arch:DimensionApplication ;
    rdfs:label "Airflow — Deployment and distribution model" ;
    arch:classifiesSystem afx:AirflowSystem ;
    arch:appliesDimension arch:D07_DeploymentAndDistributionModel ;
    arch:usesClassificationValue arch:ContainerOrchestratedDeployment, arch:PackageRegistryDistribution ;
    arch:supportedByEvidence afx:Ev_D07 ;
    arch:atScope "system" ;
    arch:confidenceLevel "Medium" .

afx:Ev_D07 a arch:EvidenceRecord ;
    arch:evidenceSummary "A Helm chart (Chart.yaml / chart/values.yaml, 13 references) and 31 container files support container-orchestrated (Kubernetes) deployment; 171 dependency manifests and PyPI packaging support package-registry distribution of core and providers. Chart and container presence verified." .

